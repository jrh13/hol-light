  let var_b0 = standardize_tm (mk_var ("b0", `:gtree`)) in
  let var_c0 = standardize_tm (mk_var ("c0", `:gtree`)) in
  let var_d0 = standardize_tm (mk_var ("d0", `:gtree`)) in
  let rec f_ge2 tm1 tm2 opt_th =
    match (tm1, tm2) with
