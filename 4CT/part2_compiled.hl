          let th1 = INST [(a5, var_t); (a6, var_e)] COND_bool_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = conv_SUB n a3 None in
          let r4 = f_TL_bool l None in
          let r5 = MK_COMB (MK_COMB (REFL a4, r3), r4) in
          f_drop_list_bool (rand (concl r3)) (rand (concl r4))
