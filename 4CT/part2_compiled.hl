let f_LENGTH_ctree_pair =
  let LENGTH_case1, LENGTH_case2 =
    match List.map standardize
      (inst_type_thms `:(ctree_pair)list->num` (local_split_thm LENGTH)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
