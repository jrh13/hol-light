          f_ctree_cons (rand (concl r1)) (rand (concl r2)) (rand (concl r3))
            (Some r4) in
        let r5 = MK_COMB (REFL a2, r4) in
        f_ctree_union a3 (rand (concl r4)) (Some (TRANS base_th r5))
      | _ -> failwith "bad pattern"
