let f_leaf_from1_fn =
  let leaf_from1_fn_eN_case1 =
    match List.map standardize (local_split_thm leaf_from1_fn_eN) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(ctree_pair)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(ctree_pair)list`)) in
  let var_h = standardize_tm (mk_var ("h'", `:num`)) in
  let var_lf = standardize_tm (mk_var ("lf", `:ctree`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_tog = standardize_tm (mk_var ("tog", `:bool`)) in
  let COND_ctree_pair_list_T =
    standardize (INST_TYPE [`:(ctree_pair)list`, aty] COND_T) in
  let COND_ctree_pair_list_F =
    standardize (INST_TYPE [`:(ctree_pair)list`, aty] COND_F) in
  let rec f_leaf_from1_fn h lf n tog opt_th =
    let base_th =
      trans_opt opt_th
 (INST [lf, var_lf; n, var_n; h, var_h;
        tog, var_tog] leaf_from1_fn_eN_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a12),
 (Comb (Comb (_, (Comb (a5, Comb (Comb (Comb (Comb (a7, _), Comb
 (Comb (Comb (_, a3), _), _)), Comb (_, a6)), a4)) as a10)),
   (Comb (a9, Comb (_, a8)) as a11)) as a13))) ->
      let r1 = conv_EQ_num h a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a12), REFL a13) in
        let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_pair_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a12), REFL a13) in
        let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_pair_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        if is_true_th (REFL tog) then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, REFL tog), REFL a10), REFL a11)
              in
          let th1 =
            INST [(a10, var_t); (a11, var_e)] COND_ctree_pair_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = conv_SUB h a6 None in
          let r3 = f_ctree_add_dyck a3 n lf None in
          let r4 = conv_ADD n a6 None in
          let r5 =
            let r5 =
              MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a7, r2), r3),
                                r4), REFL a4) in
            f_leaf_from1_fn (rand (concl r2)) (rand (concl r3))
              (rand (concl r4)) a4 (Some r5) in
          TRANS base_th (MK_COMB (REFL a5, r5))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, REFL tog), REFL a10), REFL a11)
              in
          let th1 =
            INST [(a10, var_t); (a11, var_e)] COND_ctree_pair_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = conv_SUB h a6 None in
          let r3 =
            let r3 =
              MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a7, r2), REFL lf), REFL
                                n), REFL a8) in
            f_leaf_from1_fn (rand (concl r2)) lf n a8 (Some r3) in
          TRANS base_th (MK_COMB (REFL a9, r3))
    | _ -> failwith "bad pattern"
     in
  f_leaf_from1_fn
;;

