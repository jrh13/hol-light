    match List.map standardize (local_split_thm CFCTR_MAP_CASES) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_e1 = standardize_tm (mk_var ("e", `:(cpstep)list`)) in
  let var_t1 = standardize_tm (mk_var ("t", `:(cpstep)list`)) in
  let var_e = standardize_tm (mk_var ("e", `:cpstep`)) in
  let var_t = standardize_tm (mk_var ("t", `:cpstep`)) in
  let var_mr1 = standardize_tm (mk_var ("mr", `:(bool)list`)) in
  let var_mc1 = standardize_tm (mk_var ("mc", `:(bool)list`)) in
