    match tm1 with
    | Comb (Comb (Comb (Const ("CtreeNode", _), t1), t2), t3) ->
      let base_th =
        trans_opt opt_th
          (INST [t3, var_t3; t2, var_t2; t1, var_t1] ctree_rotl_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        let r1 = f_ctree_rotl t3 None in
        let r2 = f_ctree_rotl t1 None in
        let r3 = f_ctree_rotl t2 None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), r2), r3) in
        f_ctree_cons (rand (concl r1)) (rand (concl r2)) (rand (concl r3))
