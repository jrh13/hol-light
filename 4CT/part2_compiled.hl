 (Comb (Comb (Comb (a5, Comb (Comb (a4, _), Comb (a3, Comb (a7, _)))), _),
  (Comb (a9, Comb (Comb (a8, Comb (Comb (a6, _), _)), _)) as a10)) as a12))) ->
        let r1 = f_LENGTH_color et None in
