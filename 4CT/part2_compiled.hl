  let COND_ctree_pair_list_F =
    standardize (INST_TYPE [`:(ctree_pair)list`, aty] COND_F) in
  let rec f_ITER_ctree_pair_list n (f, func_f) x opt_th =
    let base_th =
      trans_opt opt_th (INST [x, var_x; f, var_f; n, var_n] ITER_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), _),
             (Comb (_, Comb (Comb (Comb (a4, Comb (_, a3)), _), _)) as a5))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL x), REFL a5) in
        let th1 = INST [(x, var_t); (a5, var_e)] COND_ctree_pair_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL x), REFL a5) in
        let th1 = INST [(x, var_t); (a5, var_e)] COND_ctree_pair_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB n a3 None in
        let r3 =
          let r3 =
            MK_COMB (MK_COMB (MK_COMB (REFL a4, r2), REFL f), REFL x) in
          f_ITER_ctree_pair_list (rand (concl r2)) (f, func_f) x (Some r3) in
        let r4 = MK_COMB (REFL f, r3) in
        func_f (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"
     in
  f_ITER_ctree_pair_list
