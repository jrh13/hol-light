        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL l), REFL a7) in
        let th1 = INST [(l, var_t); (a7, var_e)] COND_bool_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_EQ_bool_list l a5 None in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a5), REFL a6) in
          let th1 = INST [(a5, var_t); (a6, var_e)] COND_bool_list_T in
