let f_ctree_init_tree =
  let ctree_init_tree_case1 =
    match List.map standardize (local_split_thm ctree_init_tree) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_tab = standardize_tm (mk_var ("tab", `:(ctree_pair)list`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl ctree_init_tree_case1),
 List.map (C follow_full_path (concl ctree_init_tree_case1)) ["rlbrrrlrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec abs_1 tab opt_th =
    let base_th = trans_opt opt_th (INST [tab, var_tab] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a3, Comb (Comb (a1, _), a2)), a12),
 (Comb (Comb (Comb (a11, Comb (a4, _)), Comb (a7, Comb
        (Comb (a8, Comb (a5, _)), a6))), Comb (a10, Comb (_, a9))) as a13))) ->
      let r1 = f_LENGTH_ctree_pair tab None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        conv_LT (rand (concl r1)) a2 (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a12), REFL a13) in
        let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a12), REFL a13) in
        let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 = f_HD_ctree_pair tab None in
        let r4 =
          let r4 = MK_COMB (MK_COMB (REFL a8, r3), REFL a9) in
          f_ctree_pair_sub (rand (concl r3)) a9 (Some r4) in
        let r5 =
          let r5 = MK_COMB (REFL a4, r4) in
          f_ctree_prune_1 (rand (concl r4)) (Some r5) in
        let r6 = f_TL_ctree_pair tab None in
        let r7 =
          let r7 = MK_COMB (REFL a5, r6) in
          f_HD_ctree_pair (rand (concl r6)) (Some r7) in
        let r8 =
          let r8 = MK_COMB (MK_COMB (REFL a8, r7), REFL a6) in
          f_ctree_pair_sub (rand (concl r7)) a6 (Some r8) in
        let r9 =
          let r9 = MK_COMB (REFL a7, r8) in
          f_ctree_prune_2 (rand (concl r8)) (Some r9) in
        let r10 =
          let r10 = MK_COMB (MK_COMB (REFL a8, r7), REFL a9) in
          f_ctree_pair_sub (rand (concl r7)) a9 (Some r10) in
        let r11 =
          let r11 = MK_COMB (REFL a10, r10) in
          f_ctree_prune_3 (rand (concl r10)) (Some r11) in
        let r12 = MK_COMB (MK_COMB (MK_COMB (REFL a11, r5), r9), r11) in
        f_ctree_cons (rand (concl r5)) (rand (concl r9)) (rand (concl r11))
          (Some (TRANS base_th r12))
    | _ -> failwith "bad pattern"

  and f_ctree_init_tree h opt_th =
    let base_th = trans_opt opt_th (INST [h, var_h] ctree_init_tree_case1) in
    match concl base_th with
    | Comb (_, Comb (a4, Comb (Comb (Comb (a2, Comb (_, a1)), a3), _))) ->
      let r1 = conv_SUB h a1 None in
      let r2 = (a3, f_ctree_merge_table) in
      let r3 = f_ctree_leaf_table h None in
      let r4 =
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a3), r3) in
        f_ITER_ctree_pair_list (rand (concl r1)) r2 (rand (concl r3))
          (Some r4) in
      let r5 = MK_COMB (REFL a4, r4) in
      abs_1 (rand (concl r4)) (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"

   in
  f_ctree_init_tree
;;

let f_EQ_gtree =
  let EQ_GTREE_case1, EQ_GTREE_case2, EQ_GTREE_case3, EQ_GTREE_case4,
 EQ_GTREE_case5, EQ_GTREE_case6, EQ_GTREE_case7, EQ_GTREE_case8,
