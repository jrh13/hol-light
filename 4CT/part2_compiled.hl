        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a5, r2), REFL a11), REFL a12) in
          let th1 = INST [(a11, var_t); (a12, var_e)] COND_ctree_T in
          TRANS (TRANS base_th th0) th1
        else
