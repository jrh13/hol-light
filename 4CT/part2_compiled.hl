      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (_, Comb (Comb (a1, _), a2)), a13),
 (Comb (Comb (Comb (a5, Comb (Comb (a4, _), Comb (a3, _))),
 (Comb (a11, Comb (Comb (Comb (a9, Comb (Comb (a7, a10), a8)), _), Comb
                   (a6, _))) as a12)), _) as a14))) ->
        let r1 = f_LENGTH_color et None in
