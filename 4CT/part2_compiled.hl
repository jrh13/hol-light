        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      abs_14 b1 b2 cp mc1 (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and abs_16 cp mc1 mr1 b1 opt_th =
    let base_th =
      trans_opt opt_th
       (INST [mr1, var_mr1; mc1, var_mc1; b1, var_b1; cp, var_cp] abs_16_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_15 b1 cp mc1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and f_cfctr_ok tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (mr1, mc1, Const ("NIL", _)) ->
      trans_opt opt_th (INST [mc1, var_mc1; mr1, var_mr1] CFCTR_OK_CASES_case1)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Comb
                             (Const ("CpR", _), i)), cp)) ->
      let base_th =
        trans_opt opt_th
 (INST [cp, var_cp; i, var_i; mc1, var_mc1;
        mr1, var_mr1] CFCTR_OK_CASES_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        let r1 = f_rotr_list_bool i mr1 None in
        let r2 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL mc1), REFL cp) in
        f_cfctr_ok (rand (concl r1)) mc1 cp (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp)) ->
      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_OK_CASES_case3)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp)) ->
      let base_th =
        trans_opt opt_th
        (INST [mr1, var_mr1; mc1, var_mc1; cp, var_cp] CFCTR_OK_CASES_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)),
 (Comb (Comb (_, Comb ((Comb (_, a4) as a3), _)), (Comb
 (a5, Comb (Comb (_, a12), _)) as a6)) as a16)),
 (Comb (Comb (_, Comb ((Comb (_, a8) as a7), _)), (Comb
 (Comb (a11, Comb ((Comb (_, a10) as a9), _)), (Comb (a13, _) as a14)) as a15))
   as a17))) ->
        let r1 = f_EQ_cpstep_list cp a1 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a16), REFL a17) in
          let th1 = INST [(a16, var_t); (a17, var_e)] COND_bool_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_LENGTH_bool mr1 None in
          let r3 =
            let r3 = MK_COMB (REFL a3, r2) in
            conv_LE a4 (rand (concl r2)) (Some r3) in
          if is_true_th r3 then
            let th0 = MK_COMB (MK_COMB (REFL a11, r3), REFL a6) in
            let th1 = INST[a6, p_var_bool] T_AND in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r4 = f_EL_bool a12 mr1 None in
            let r5 = MK_COMB (REFL a5, r4) in
            abs_11 mr1 (rand (concl r4)) (Some (TRANS base_th r5))
          else
            let th0 = MK_COMB (MK_COMB (REFL a11, r3), REFL a6) in
            let th1 = INST[a6, p_var_bool] F_AND in
            TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a16), REFL a17) in
          let th1 = INST [(a16, var_t); (a17, var_e)] COND_bool_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_LENGTH_bool mr1 None in
          let r3 =
            let r3 = MK_COMB (REFL a7, r2) in
            conv_LE a8 (rand (concl r2)) (Some r3) in
          if is_true_th r3 then
            let th0 = MK_COMB (MK_COMB (REFL a11, r3), REFL a15) in
            let th1 = INST[a15, p_var_bool] T_AND in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r4 = f_LENGTH_bool mc1 None in
            let r5 =
              let r5 = MK_COMB (REFL a9, r4) in
              conv_LE a10 (rand (concl r4)) (Some r5) in
            if is_true_th r5 then
              let th0 = MK_COMB (MK_COMB (REFL a11, r5), REFL a14) in
              let th1 = INST[a14, p_var_bool] T_AND in
              let base_th = TRANS (TRANS base_th th0) th1 in
              let r6 = f_EL_bool a12 mr1 None in
              let r7 = MK_COMB (REFL a13, r6) in
              abs_16 cp mc1 mr1 (rand (concl r6)) (Some (TRANS base_th r7))
            else
              let th0 = MK_COMB (MK_COMB (REFL a11, r5), REFL a14) in
              let th1 = INST[a14, p_var_bool] F_AND in
