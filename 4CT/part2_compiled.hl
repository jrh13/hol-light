 (INST [d, var_d; lpt, var_lpt; pt2, var_pt2; pt1, var_pt1; pt0, var_pt0]
   gtree_merge_line_case1) in
    f_gtree_merge_line_fn d pt0 pt1 pt2 lpt (Some base_th) in
  f_gtree_merge_line
;;

let f_gtree_init_table_fn =
  let gtree_init_table_fn_eNx_case1 =
    match List.map standardize (local_split_thm gtree_init_table_fn_eNx) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(gtree_pair)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(gtree_pair)list`)) in
  let var_h = standardize_tm (mk_var ("h''", `:num`)) in
  let var_d = standardize_tm (mk_var ("d", `:num`)) in
  let var_tab = standardize_tm (mk_var ("tab", `:(gtree_pair)list`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrl" (concl gtree_init_table_fn_eNx_case1),
 List.map (C follow_full_path (concl gtree_init_table_fn_eNx_case1))
   ["rrlbrlrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_gtree_pair_list_T =
    standardize (INST_TYPE [`:(gtree_pair)list`, aty] COND_T) in
  let COND_gtree_pair_list_F =
    standardize (INST_TYPE [`:(gtree_pair)list`, aty] COND_F) in
  let rec abs_1 d tab opt_th =
    let base_th = trans_opt opt_th (INST [tab, var_tab; d, var_d] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a3, Comb (Comb (a1, _), a2)), _),
 (Comb (Comb (Comb (Comb (Comb (a6, _), Comb (a4, _)), a7), Comb (a5, _)), _)
   as a8))) ->
      let r1 = f_LENGTH_gtree_pair tab None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        conv_LT (rand (concl r1)) a2 (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL tab), REFL a8) in
        let th1 = INST [(tab, var_t); (a8, var_e)] COND_gtree_pair_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL tab), REFL a8) in
        let th1 = INST [(tab, var_t); (a8, var_e)] COND_gtree_pair_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 = f_TL_gtree_pair tab None in
        let r4 =
          let r4 = MK_COMB (REFL a4, r3) in
          f_HD_gtree_pair (rand (concl r3)) (Some r4) in
        let r5 = f_HD_gtree_pair tab None in
        let r6 =
          let r6 = MK_COMB (REFL a5, r3) in
          f_TL_gtree_pair (rand (concl r3)) (Some r6) in
        let r7 =
          MK_COMB (MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a6, r4), r5), REFL
                                     a7), r6), REFL d) in
        f_gtree_merge_line (rand (concl r4)) (rand (concl r5)) a7
          (rand (concl r6)) d (Some (TRANS base_th r7))
    | _ -> failwith "bad pattern"

  and f_gtree_init_table_fn h d opt_th =
    let base_th =
      trans_opt opt_th
        (INST [d, var_d; h, var_h] gtree_init_table_fn_eNx_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a6),
                     (Comb (a5, Comb (Comb (a4, Comb (_, a3)), _)) as a7))) ->
      let r1 = conv_EQ_num h a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_gtree_pair_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_gtree_pair_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB h a3 None in
        let r3 = conv_SUC d None in
        let r4 =
          let r4 = MK_COMB (MK_COMB (REFL a4, r2), r3) in
          f_gtree_init_table_fn (rand (concl r2)) (rand (concl r3))
            (Some r4) in
        let r5 = MK_COMB (REFL a5, r4) in
        abs_1 d (rand (concl r4)) (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"

   in
  f_gtree_init_table_fn
;;

