          let th1 = INST [(a4, var_t1); (a5, var_e)] COND_gtree_pair_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_ge4 t_0 t_1 t_2 t_3 None in
          if is_true_th r2 then
            let th0 =
