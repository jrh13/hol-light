    let base_th =
      trans_opt opt_th (INST [l, var_l; n, var_n] rotr_list_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a2, Comb (Comb (a1, _), _)), _)) ->
      let r1 = f_LENGTH_color l None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL n) in
        conv_SUB (rand (concl r1)) n (Some r2) in
      let r3 = MK_COMB (MK_COMB (REFL a2, r2), REFL l) in
      f_rot_list_color (rand (concl r2)) l (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"
     in
  f_rotr_list_color
;;

let f_cpcol =
  let CPCOL_CLAUSES_case1, CPCOL_CLAUSES_case2, CPCOL_CLAUSES_case3,
 CPCOL_CLAUSES_case4, CPCOL_CLAUSES_case5, CPCOL_CLAUSES_case6,
   CPCOL_CLAUSES_case7, CPCOL_CLAUSES_case8 =
    match List.map standardize (local_split_thm CPCOL_CLAUSES) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_e1 = standardize_tm (mk_var ("e", `:(color)list`)) in
  let var_t1 = standardize_tm (mk_var ("t", `:(color)list`)) in
  let var_e = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let var_et = standardize_tm (mk_var ("et", `:(color)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let COND_color_list_T =
    standardize (INST_TYPE [`:(color)list`, aty] COND_T) in
  let COND_color_list_F =
    standardize (INST_TYPE [`:(color)list`, aty] COND_F) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec f_cpcol tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Const ("NIL", _), et) ->
      let base_th =
        trans_opt opt_th (INST [et, var_et] CPCOL_CLAUSES_case1) in
      f_cpbranch et (Some base_th)
    | (Comb (Comb (Const ("CONS", _), Comb (Const ("CpR", _), n)), cp), et) ->
      let base_th =
        trans_opt opt_th
          (INST [et, var_et; cp, var_cp; n, var_n] CPCOL_CLAUSES_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_rot_list_color n et None in
        let r2 = MK_COMB (REFL a1, r1) in
        f_cpcol cp (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp), et) ->
      let base_th =
        trans_opt opt_th (INST [et, var_et; cp, var_cp] CPCOL_CLAUSES_case3) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (Comb (a1, _), a3)), a5),
                       (Comb (a4, _) as a6))) ->
        let r1 = f_LENGTH_color et None in
        let r2 =
          let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a3) in
          conv_LE (rand (concl r1)) a3 (Some r2) in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a5), REFL a6) in
          let th1 = INST [(a5, var_t); (a6, var_e)] COND_ctree_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a5), REFL a6) in
          let th1 = INST [(a5, var_t); (a6, var_e)] COND_ctree_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = f_rotr_list_color a3 et None in
          let r4 = MK_COMB (REFL a4, r3) in
          f_cpcol cp (rand (concl r3)) (Some (TRANS base_th r4))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp), et) ->
      let base_th =
        trans_opt opt_th (INST [et, var_et; cp, var_cp] CPCOL_CLAUSES_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a10),
 (Comb (Comb (a9, Comb (a8, Comb (Comb (_, Comb ((Comb (_, a4) as a3), _)),
        Comb (Comb (a7, Comb ((Comb (_, a6) as a5), _)), _)))), _) as a11))) ->
        let r1 = f_EQ_color_list et a1 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a10), REFL a11) in
          let th1 = INST [(a10, var_t); (a11, var_e)] COND_ctree_T in
