;;

let f_LENGTH_gtree_pair =
  let LENGTH_case1, LENGTH_case2 =
    match List.map standardize
      (inst_type_thms `:(gtree_pair)list->num` (local_split_thm LENGTH)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:gtree_pair`)) in
  let var_t = standardize_tm (mk_var ("t", `:(gtree_pair)list`)) in
  let rec f_LENGTH_gtree_pair tm1 opt_th =
    match tm1 with
    | Const ("NIL", _) -> trans_opt opt_th LENGTH_case1
    | Comb (Comb (Const ("CONS", _), h), t) ->
      let base_th =
        trans_opt opt_th (INST [t, var_t; h, var_h] LENGTH_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_LENGTH_gtree_pair t None in
        let r2 = MK_COMB (REFL a1, r1) in
        conv_SUC (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_LENGTH_gtree_pair"
     in
  f_LENGTH_gtree_pair
;;

