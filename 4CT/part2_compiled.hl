;;

let f_cpbranch =
  let cpbranch_case1 =
    match List.map standardize (local_split_thm cpbranch) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_et = standardize_tm (mk_var ("et", `:(color)list`)) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec f_cpbranch et opt_th =
    let base_th = trans_opt opt_th (INST [et, var_et] cpbranch_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (_, Comb (Comb (a1, _), a2)), a13),
 (Comb (Comb (Comb (a6, Comb (Comb (a4, Comb (a3, Comb (a10, _))), a5)), _),
 (Comb ((Comb (_, (Comb (a9, Comb (a7, _)) as a8)) as a11), _) as a12))
   as a14))) ->
      let r1 = f_LENGTH_color et None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        conv_LT (rand (concl r1)) a2 (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a6, r2), REFL a13), REFL a14) in
        let th1 = INST [(a13, var_t); (a14, var_e)] COND_ctree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a6, r2), REFL a13), REFL a14) in
        let th1 = INST [(a13, var_t); (a14, var_e)] COND_ctree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 = f_TL_color et None in
        let r4 =
          let r4 = MK_COMB (REFL a3, r3) in
          f_HD_color (rand (concl r3)) (Some r4) in
        let r5 =
          let r5 = MK_COMB (MK_COMB (REFL a4, r4), REFL a5) in
          f_EQ_color (rand (concl r4)) a5 (Some r5) in
        if is_true_th r5 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a6, r5), REFL a13), REFL a12) in
          let th1 = INST [(a13, var_t); (a12, var_e)] COND_ctree_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a6, r5), REFL a13), REFL a12) in
          let th1 = INST [(a13, var_t); (a12, var_e)] COND_ctree_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r6 =
            let r6 = MK_COMB (REFL a7, r4) in
            f_edge_rot (rand (concl r4)) (Some r6) in
          let r7 =
            (a8, fun tm1 opt_th ->
                   let r7 = MK_COMB (MK_COMB (REFL a9, r6), REFL tm1) in
                   f_permc (rand (concl r6)) tm1 (Some (trans_opt opt_th r7)))
                     in
          let r8 =
            let r8 = MK_COMB (REFL a10, r3) in
            f_TL_color (rand (concl r3)) (Some r8) in
          let r9 = MK_COMB (REFL a11, r8) in
          f_cfcbr1 r7 (rand (concl r8)) (Some (TRANS base_th r9))
    | _ -> failwith "bad pattern"
     in
  f_cpbranch
;;

let f_ctree_union =
  let CTREE_UNION_FO_case1, CTREE_UNION_FO_case2, CTREE_UNION_FO_case3,
 CTREE_UNION_FO_case4, CTREE_UNION_FO_case5, CTREE_UNION_FO_case6,
   CTREE_UNION_FO_case7, CTREE_UNION_FO_case8, CTREE_UNION_FO_case9 =
    match List.map standardize (local_split_thm CTREE_UNION_FO) with
    | [th1; th2; th3; th4; th5; th6; th7; th8; th9] ->
      (th1, th2, th3, th4, th5, th6, th7, th8, th9)
    | _ -> failwith "error"
     in
  let var_lr = standardize_tm (mk_var ("lr", `:ctree`)) in
  let var_ar = standardize_tm (mk_var ("ar", `:ctree`)) in
  let var_br = standardize_tm (mk_var ("br", `:ctree`)) in
  let var_cr = standardize_tm (mk_var ("cr", `:ctree`)) in
  let var_ll = standardize_tm (mk_var ("ll", `:ctree`)) in
  let var_al = standardize_tm (mk_var ("al", `:ctree`)) in
  let var_bl = standardize_tm (mk_var ("bl", `:ctree`)) in
  let var_cl = standardize_tm (mk_var ("cl", `:ctree`)) in
  let rec f_ctree_union tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Comb (Comb (Comb (Const ("CtreeNode", _), al), bl), cl), Comb
       (Comb (Comb (Const ("CtreeNode", _), ar), br), cr)) ->
      let base_th =
        trans_opt opt_th
 (INST [cr, var_cr; br, var_br; ar, var_ar; cl, var_cl; bl, var_bl; al, var_al]
   CTREE_UNION_FO_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        let r1 = f_ctree_union al ar None in
        let r2 = f_ctree_union bl br None in
        let r3 = f_ctree_union cl cr None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), r2), r3) in
        f_ctree_cons (rand (concl r1)) (rand (concl r2)) (rand (concl r3))
          (Some (TRANS base_th r4))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Comb (Const ("CtreeNode", _), al), bl), cl), Comb
       (Const ("CtreeLeaf", _), lr)) ->
      trans_opt opt_th
   (INST [lr, var_lr; cl, var_cl; bl, var_bl; al, var_al] CTREE_UNION_FO_case2)
    | (Comb (Comb (Comb (Const ("CtreeNode", _), al), bl), cl), Const
       ("CtreeEmpty", _)) ->
      trans_opt opt_th
        (INST [cl, var_cl; bl, var_bl; al, var_al] CTREE_UNION_FO_case3)
    | (Comb (Const ("CtreeLeaf", _), ll), Comb (Comb
                               (Comb (Const ("CtreeNode", _), ar), br), cr)) ->
      trans_opt opt_th
   (INST [cr, var_cr; br, var_br; ar, var_ar; ll, var_ll] CTREE_UNION_FO_case4)
    | (Comb (Const ("CtreeLeaf", _), ll), Comb (Const ("CtreeLeaf", _), lr)) ->
      trans_opt opt_th (INST [lr, var_lr; ll, var_ll] CTREE_UNION_FO_case5)
    | (Comb (Const ("CtreeLeaf", _), ll), Const ("CtreeEmpty", _)) ->
      trans_opt opt_th (INST [ll, var_ll] CTREE_UNION_FO_case6)
    | (Const ("CtreeEmpty", _), Comb (Comb (Comb (Const ("CtreeNode", _), ar),
                                            br), cr)) ->
      trans_opt opt_th
        (INST [cr, var_cr; br, var_br; ar, var_ar] CTREE_UNION_FO_case7)
    | (Const ("CtreeEmpty", _), Comb (Const ("CtreeLeaf", _), lr)) ->
      trans_opt opt_th (INST [lr, var_lr] CTREE_UNION_FO_case8)
    | (Const ("CtreeEmpty", _), Const ("CtreeEmpty", _)) ->
      trans_opt opt_th CTREE_UNION_FO_case9
    | _ -> failwith "No match: f_ctree_union"
     in
  f_ctree_union
;;

let f_APPEND_color =
  let APPEND_case1, APPEND_case2 =
    match List.map standardize
 (inst_type_thms `:(color)list->(color)list->(color)list`
 (local_split_thm APPEND)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:color`)) in
  let var_t = standardize_tm (mk_var ("t", `:(color)list`)) in
  let var_l = standardize_tm (mk_var ("l", `:(color)list`)) in
  let rec f_APPEND_color tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Const ("NIL", _), l) -> trans_opt opt_th (INST [l, var_l] APPEND_case1)
    | (Comb (Comb (Const ("CONS", _), h), t), l) ->
      let base_th =
        trans_opt opt_th (INST [l, var_l; t, var_t; h, var_h] APPEND_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_APPEND_color t l None in
        TRANS base_th (MK_COMB (REFL a1, r1))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_APPEND_color"
     in
  f_APPEND_color
;;

let f_drop_list_color =
  let DROP_LIST_NUM_case1 =
    match List.map standardize
 (inst_type_thms `:num->(color)list->(color)list`
 (local_split_thm DROP_LIST_NUM)) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(color)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(color)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_l = standardize_tm (mk_var ("l", `:(color)list`)) in
  let COND_color_list_T =
    standardize (INST_TYPE [`:(color)list`, aty] COND_T) in
  let COND_color_list_F =
    standardize (INST_TYPE [`:(color)list`, aty] COND_F) in
  let rec f_drop_list_color n l opt_th =
    let base_th =
      trans_opt opt_th (INST [l, var_l; n, var_n] DROP_LIST_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), _),
    (Comb (Comb (_, a5), (Comb (Comb (a4, Comb (_, a3)), _) as a6)) as a7))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL l), REFL a7) in
        let th1 = INST [(l, var_t); (a7, var_e)] COND_color_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL l), REFL a7) in
        let th1 = INST [(l, var_t); (a7, var_e)] COND_color_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_EQ_color_list l a5 None in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a5), REFL a6) in
          let th1 = INST [(a5, var_t); (a6, var_e)] COND_color_list_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a5), REFL a6) in
          let th1 = INST [(a5, var_t); (a6, var_e)] COND_color_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = conv_SUB n a3 None in
          let r4 = f_TL_color l None in
          let r5 = MK_COMB (MK_COMB (REFL a4, r3), r4) in
          f_drop_list_color (rand (concl r3)) (rand (concl r4))
            (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"
     in
  f_drop_list_color
;;

let f_take_list_color =
  let TAKE_LIST_NUM_case1 =
    match List.map standardize
 (inst_type_thms `:num->(color)list->(color)list`
