let f_mask_pred1_from =
  let MASK_PRED1_FROM_NUM_case1 =
    match List.map standardize (local_split_thm MASK_PRED1_FROM_NUM) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(bool)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let var_j = standardize_tm (mk_var ("j", `:num`)) in
  let var_i = standardize_tm (mk_var ("i", `:num`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let COND_bool_list_T =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_T) in
  let COND_bool_list_F =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_F) in
  let rec f_mask_pred1_from j i n opt_th =
    let base_th =
      trans_opt opt_th
        (INST [n, var_n; i, var_i; j, var_j] MASK_PRED1_FROM_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a6),
  (Comb (Comb (a5, _), Comb (Comb (Comb (a4, _), _), Comb (_, a3))) as a7))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_EQ_num j i None in
        let r3 = conv_SUC j None in
        let r4 = conv_SUB n a3 None in
        let r5 =
          let r5 = MK_COMB (MK_COMB (MK_COMB (REFL a4, r3), REFL i), r4) in
          f_mask_pred1_from (rand (concl r3)) i (rand (concl r4)) (Some r5) in
        TRANS base_th (MK_COMB (MK_COMB (REFL a5, r2), r5))
    | _ -> failwith "bad pattern"
     in
  f_mask_pred1_from
;;

let f_mask_pred1 =
  let mask_pred1_case1 =
    match List.map standardize (local_split_thm mask_pred1) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_i = standardize_tm (mk_var ("i", `:num`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let rec f_mask_pred1 i n opt_th =
    let base_th =
      trans_opt opt_th (INST [n, var_n; i, var_i] mask_pred1_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (_, a1), _), _)) ->
      f_mask_pred1_from a1 i n (Some base_th)
    | _ -> failwith "bad pattern"
     in
  f_mask_pred1
;;

let f_cfmask1 =
