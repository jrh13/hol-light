      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_OK_CASES_case8)
    | _ -> failwith "No match: f_cfctr_ok"

   in
  f_cfctr_ok
;;

let f_cfctr =
  let cfctr_case1 =
    match List.map standardize (local_split_thm cfctr) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:((cpstep)list)option`)) in
  let var_t = standardize_tm (mk_var ("t", `:((cpstep)list)option`)) in
  let var_mr = standardize_tm (mk_var ("mr", `:(bool)list`)) in
  let var_mc = standardize_tm (mk_var ("mc", `:(bool)list`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let COND_cpstep_list_option_T =
    standardize (INST_TYPE [`:((cpstep)list)option`, aty] COND_T) in
  let COND_cpstep_list_option_F =
    standardize (INST_TYPE [`:((cpstep)list)option`, aty] COND_F) in
  let rec f_cfctr mr mc cp opt_th =
    let base_th =
      trans_opt opt_th
        (INST [cp, var_cp; mc, var_mc; mr, var_mr] cfctr_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a1, _), (Comb (a2, _) as a3)), a4)) ->
      let r1 = f_cfctr_ok mr mc cp None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
        let th1 = INST [(a3, var_t); (a4, var_e)] COND_cpstep_list_option_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_cfctr_map mr mc cp None in
        TRANS base_th (MK_COMB (REFL a2, r2))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
        let th1 = INST [(a3, var_t); (a4, var_e)] COND_cpstep_list_option_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
  f_cfctr
;;

let f_APPEND_cpstep =
  let APPEND_case1, APPEND_case2 =
    match List.map standardize
 (inst_type_thms `:(cpstep)list->(cpstep)list->(cpstep)list`
 (local_split_thm APPEND)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:cpstep`)) in
  let var_t = standardize_tm (mk_var ("t", `:(cpstep)list`)) in
  let var_l = standardize_tm (mk_var ("l", `:(cpstep)list`)) in
  let rec f_APPEND_cpstep tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Const ("NIL", _), l) -> trans_opt opt_th (INST [l, var_l] APPEND_case1)
    | (Comb (Comb (Const ("CONS", _), h), t), l) ->
      let base_th =
        trans_opt opt_th (INST [l, var_l; t, var_t; h, var_h] APPEND_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_APPEND_cpstep t l None in
        TRANS base_th (MK_COMB (REFL a1, r1))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_APPEND_cpstep"
     in
  f_APPEND_cpstep
;;

let f_REVERSE_cpstep =
  let REVERSE_case1, REVERSE_case2 =
    match List.map standardize
  (inst_type_thms `:(cpstep)list->(cpstep)list` (local_split_thm REVERSE)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:cpstep`)) in
  let var_l = standardize_tm (mk_var ("l", `:(cpstep)list`)) in
  let rec f_REVERSE_cpstep tm1 opt_th =
    match tm1 with
    | Const ("NIL", _) -> trans_opt opt_th REVERSE_case1
    | Comb (Comb (Const ("CONS", _), x), l) ->
      let base_th =
        trans_opt opt_th (INST [l, var_l; x, var_x] REVERSE_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = f_REVERSE_cpstep l None in
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        f_APPEND_cpstep (rand (concl r1)) a2 (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_REVERSE_cpstep"
     in
  f_REVERSE_cpstep
;;

let f_EQ_color =
  let EQ_COLOR_case1, EQ_COLOR_case2, EQ_COLOR_case3, EQ_COLOR_case4,
 EQ_COLOR_case5, EQ_COLOR_case6, EQ_COLOR_case7, EQ_COLOR_case8,
 EQ_COLOR_case9, EQ_COLOR_case10, EQ_COLOR_case11, EQ_COLOR_case12,
   EQ_COLOR_case13 =
    match List.map standardize (local_split_thm EQ_COLOR) with
    | [th1; th2; th3; th4; th5; th6; th7; th8; th9; th10; th11; th12; th13] ->
      (th1, th2, th3, th4, th5, th6, th7, th8, th9, th10, th11, th12, th13)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:color`)) in
  let rec f_EQ_color tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (x, x1) when compare x x1 = 0 ->
      trans_opt opt_th (INST [x, var_x] EQ_COLOR_case1)
    | (Const ("Color0", _), Const ("Color1", _)) ->
      trans_opt opt_th EQ_COLOR_case2
    | (Const ("Color1", _), Const ("Color0", _)) ->
      trans_opt opt_th EQ_COLOR_case3
    | (Const ("Color0", _), Const ("Color2", _)) ->
      trans_opt opt_th EQ_COLOR_case4
    | (Const ("Color2", _), Const ("Color0", _)) ->
      trans_opt opt_th EQ_COLOR_case5
    | (Const ("Color0", _), Const ("Color3", _)) ->
      trans_opt opt_th EQ_COLOR_case6
    | (Const ("Color3", _), Const ("Color0", _)) ->
      trans_opt opt_th EQ_COLOR_case7
    | (Const ("Color1", _), Const ("Color2", _)) ->
      trans_opt opt_th EQ_COLOR_case8
    | (Const ("Color2", _), Const ("Color1", _)) ->
      trans_opt opt_th EQ_COLOR_case9
    | (Const ("Color1", _), Const ("Color3", _)) ->
      trans_opt opt_th EQ_COLOR_case10
    | (Const ("Color3", _), Const ("Color1", _)) ->
      trans_opt opt_th EQ_COLOR_case11
    | (Const ("Color2", _), Const ("Color3", _)) ->
      trans_opt opt_th EQ_COLOR_case12
    | (Const ("Color3", _), Const ("Color2", _)) ->
      trans_opt opt_th EQ_COLOR_case13
    | _ -> failwith "No match: f_EQ_color"
     in
  f_EQ_color
;;

let f_EQ_color_list =
  let EQ_LIST_case1, EQ_LIST_case2, EQ_LIST_case3, EQ_LIST_case4 =
    match List.map standardize
 (inst_type_thms `:(color)list->(color)list->bool` (local_split_thm EQ_LIST))
   with
    | [th1; th2; th3; th4] -> (th1, th2, th3, th4)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:color`)) in
  let var_xs = standardize_tm (mk_var ("xs", `:(color)list`)) in
  let var_y = standardize_tm (mk_var ("y", `:color`)) in
  let var_ys = standardize_tm (mk_var ("ys", `:(color)list`)) in
  let rec f_EQ_color_list tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (xs, xs1) when compare xs xs1 = 0 ->
      trans_opt opt_th (INST [xs, var_xs] EQ_LIST_case1)
    | (Const ("NIL", _), Comb (Comb (Const ("CONS", _), x), xs)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case2)
    | (Comb (Comb (Const ("CONS", _), x), xs), Const ("NIL", _)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case3)
    | (Comb (Comb (Const ("CONS", _), x), xs), Comb (Comb
                                                (Const ("CONS", _), y), ys)) ->
      let base_th =
        trans_opt opt_th
          (INST [ys, var_ys; y, var_y; xs, var_xs; x, var_x] EQ_LIST_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = f_EQ_color x y None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EQ_color_list xs ys (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EQ_color_list"
     in
  f_EQ_color_list
;;

