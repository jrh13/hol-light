  let var_t_1 = standardize_tm (mk_var ("t''1", `:gtree`)) in
  let var_t_21 = standardize_tm (mk_var ("t'2", `:gtree`)) in
  let var_t_2 = standardize_tm (mk_var ("t''2", `:gtree`)) in
  let var_t_31 = standardize_tm (mk_var ("t'3", `:gtree`)) in
  let var_t_3 = standardize_tm (mk_var ("t''3", `:gtree`)) in
  let COND_gtree_pair_T =
    standardize (INST_TYPE [`:gtree_pair`, aty] COND_T) in
  let COND_gtree_pair_F =
    standardize (INST_TYPE [`:gtree_pair`, aty] COND_F) in
  let rec f_gtree_cons_pairs tm1 tm2 tm3 tm4 tm5 opt_th =
    match (tm1, tm2, tm3, tm4, tm5) with
    | (t, Comb (Comb (Const ("GtreePair", _), t_01), t_0), Comb
