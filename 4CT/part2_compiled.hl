  let COND_bool_list_F =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_F) in
  let rec f_FILTER_bool tm1 tm2 opt_th =
    match (tm1, tm2) with
    | ((id_P, func_id_P), Const ("NIL", _)) ->
      trans_opt opt_th (INST [id_P, var_id_P] FILTER_case1)
    | ((id_P, func_id_P), Comb (Comb (Const ("CONS", _), h), t)) ->
      let base_th =
        trans_opt opt_th
          (INST [id_P, var_id_P; t, var_t; h, var_h] FILTER_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), (Comb (a2, _) as a3)), a4)) ->
        let r1 = func_id_P h None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_bool_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_FILTER_bool (id_P, func_id_P) t None in
          TRANS base_th (MK_COMB (REFL a2, r2))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_bool_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_FILTER_bool (id_P, func_id_P) t (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_FILTER_bool"
     in
  f_FILTER_bool
