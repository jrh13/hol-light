let f_gtree_pair_sub =
  let gtree_pair_sub_case1 =
    match List.map standardize (local_split_thm gtree_pair_sub) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:gtree`)) in
  let var_t = standardize_tm (mk_var ("t", `:gtree`)) in
  let var_t0 = standardize_tm (mk_var ("t0", `:gtree`)) in
  let var_t1 = standardize_tm (mk_var ("t1", `:gtree`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let COND_gtree_T = standardize (INST_TYPE [`:gtree`, aty] COND_T) in
  let COND_gtree_F = standardize (INST_TYPE [`:gtree`, aty] COND_F) in
  let rec f_gtree_pair_sub tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Comb (Comb (Const ("GtreePair", _), t0), t1), b) ->
      let base_th =
        trans_opt opt_th
          (INST [b, var_b; t1, var_t1; t0, var_t0] gtree_pair_sub_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        if is_true_th (REFL b) then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL t1), REFL t0) in
          let th1 = INST [(t1, var_t); (t0, var_e)] COND_gtree_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL t1), REFL t0) in
          let th1 = INST [(t1, var_t); (t0, var_e)] COND_gtree_F in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_gtree_pair_sub"
     in
  f_gtree_pair_sub
;;

let f_gtree_init_tree =
  let gtree_init_tree_case1 =
    match List.map standardize (local_split_thm gtree_init_tree) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:gtree`)) in
  let var_t = standardize_tm (mk_var ("t", `:gtree`)) in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_tab = standardize_tm (mk_var ("tab", `:(gtree_pair)list`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrl" (concl gtree_init_tree_case1),
   List.map (C follow_full_path (concl gtree_init_tree_case1)) ["rrlbrlrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_gtree_T = standardize (INST_TYPE [`:gtree`, aty] COND_T) in
  let COND_gtree_F = standardize (INST_TYPE [`:gtree`, aty] COND_F) in
  let rec abs_1 tab opt_th =
    let base_th = trans_opt opt_th (INST [tab, var_tab] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a5),
                     (Comb (Comb (a3, _), a4) as a6))) ->
      let r1 = f_EQ_gtree_pair_list tab a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a5), REFL a6) in
        let th1 = INST [(a5, var_t); (a6, var_e)] COND_gtree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a5), REFL a6) in
        let th1 = INST [(a5, var_t); (a6, var_e)] COND_gtree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_HD_gtree_pair tab None in
        let r3 = MK_COMB (MK_COMB (REFL a3, r2), REFL a4) in
        f_gtree_pair_sub (rand (concl r2)) a4 (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and f_gtree_init_tree h opt_th =
    let base_th = trans_opt opt_th (INST [h, var_h] gtree_init_tree_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a1, Comb (_, a4)), a6),
                     (Comb (a5, Comb (a3, Comb (_, a2))) as a7))) ->
      let r1 = conv_EQ_num h a4 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_gtree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_gtree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB h a2 None in
        let r3 =
          let r3 = MK_COMB (REFL a3, r2) in
          f_gtree_init_table a4 (rand (concl r2)) (Some r3) in
        let r4 = MK_COMB (REFL a5, r3) in
        abs_1 (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

   in
  f_gtree_init_tree
;;

let f_gl1 =
