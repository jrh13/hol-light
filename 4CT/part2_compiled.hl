    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_18_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl CPADJ_CLAUSES_case2),
   List.map (C follow_full_path (concl CPADJ_CLAUSES_case2)) ["rlbrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_bool_list_T =
