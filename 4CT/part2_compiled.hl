  let abs_18_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl CFCTR_MAP_CASES_case2),
   List.map (C follow_full_path (concl CFCTR_MAP_CASES_case2)) ["rlbrllr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_cpstep_list_T =
    standardize (INST_TYPE [`:(cpstep)list`, aty] COND_T) in
  let COND_cpstep_list_F =
    standardize (INST_TYPE [`:(cpstep)list`, aty] COND_F) in
  let COND_cpstep_T = standardize (INST_TYPE [`:cpstep`, aty] COND_T) in
  let COND_cpstep_F = standardize (INST_TYPE [`:cpstep`, aty] COND_F) in
  let rec abs_1 b3 b1 b2 b4 b5 cpc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [cpc, var_cpc; b5, var_b5; b4, var_b4; b2, var_b2; b1, var_b1;
        b3, var_b3] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (_, (Comb (Comb (_, (Comb (Comb (_, a1),
 (Comb (_, a3) as a2)) as a12)),
 (Comb (Comb (_, a10), (Comb (Comb (_, (Comb (Comb (Comb (a5, _), a4), a6) as
                     a8)), (Comb (_, a7) as a9)) as a11)) as a13)) as a14))) ->
      if is_true_th (REFL b3) then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b3), REFL cpc), REFL a14) in
        let th1 = INST [(cpc, var_t1); (a14, var_e1)] COND_cpstep_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b3), REFL cpc), REFL a14) in
        let th1 = INST [(cpc, var_t1); (a14, var_e1)] COND_cpstep_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        if is_true_th (REFL b1) then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b1), REFL a12), REFL a13)
              in
          let th1 = INST [(a12, var_t1); (a13, var_e1)] COND_cpstep_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          if is_true_th (REFL b2) then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b2), REFL a1), REFL a2)
                in
            let th1 = INST [(a1, var_t1); (a2, var_e1)] COND_cpstep_list_T in
            TRANS (TRANS base_th th0) th1
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b2), REFL a1), REFL a2)
                in
            let th1 = INST [(a1, var_t1); (a2, var_e1)] COND_cpstep_list_F in
            let base_th = TRANS (TRANS base_th th0) th1 in
            if is_true_th (REFL b5) then
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                  cpc), REFL a3) in
              let th1 =
                INST [(cpc, var_t1); (a3, var_e1)] COND_cpstep_list_T in
              TRANS (TRANS base_th th0) th1
            else
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                  cpc), REFL a3) in
              let th1 =
                INST [(cpc, var_t1); (a3, var_e1)] COND_cpstep_list_F in
              TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b1), REFL a12), REFL a13)
              in
          let th1 = INST [(a12, var_t1); (a13, var_e1)] COND_cpstep_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          if is_true_th (REFL b2) then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b2), REFL a10),
                       REFL a11) in
            let th1 =
              INST [(a10, var_t1); (a11, var_e1)] COND_cpstep_list_T in
            let base_th = TRANS (TRANS base_th th0) th1 in
            if is_true_th (REFL b4) then
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b4), REFL
                                  cpc), REFL a3) in
              let th1 =
                INST [(cpc, var_t1); (a3, var_e1)] COND_cpstep_list_T in
              TRANS (TRANS base_th th0) th1
            else
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b4), REFL
                                  cpc), REFL a3) in
              let th1 =
                INST [(cpc, var_t1); (a3, var_e1)] COND_cpstep_list_F in
              TRANS (TRANS base_th th0) th1
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b2), REFL a10),
                       REFL a11) in
            let th1 =
              INST [(a10, var_t1); (a11, var_e1)] COND_cpstep_list_F in
            let base_th = TRANS (TRANS base_th th0) th1 in
            if is_true_th (REFL b4) then
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b4), REFL
                                  a8), REFL a9) in
              let th1 =
                INST [(a8, var_t1); (a9, var_e1)] COND_cpstep_list_T in
              let base_th = TRANS (TRANS base_th th0) th1 in
              if is_true_th (REFL b5) then
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                    a4), REFL a6) in
                let th1 =
                  INST [(a4, var_t1); (a6, var_e1)] COND_cpstep_list_T in
                TRANS (TRANS base_th th0) th1
              else
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                    a4), REFL a6) in
                let th1 =
                  INST [(a4, var_t1); (a6, var_e1)] COND_cpstep_list_F in
                TRANS (TRANS base_th th0) th1
            else
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b4), REFL
                                  a8), REFL a9) in
              let th1 =
                INST [(a8, var_t1); (a9, var_e1)] COND_cpstep_list_F in
              let base_th = TRANS (TRANS base_th th0) th1 in
              if is_true_th (REFL b5) then
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                    a6), REFL a7) in
                let th1 =
                  INST [(a6, var_t1); (a7, var_e1)] COND_cpstep_list_T in
                TRANS (TRANS base_th th0) th1
              else
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a5, REFL b5), REFL
                                    a6), REFL a7) in
                let th1 =
                  INST [(a6, var_t1); (a7, var_e1)] COND_cpstep_list_F in
                TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and abs_2 b3 b1 b2 b4 b5 mr cp mc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b5, var_b5; b4, var_b4; b2, var_b2; mc, var_mc; cp, var_cp; mr, var_mr;
        b1, var_b1; b3, var_b3] abs_2_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (Comb (_, a1), _), _))) ->
      let r1 = f_cfctr_map a1 mc cp None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_1 b3 b1 b2 b4 b5 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_3 b3 b1 b2 b4 mr cp mc1 b5 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b5, var_b5; b4, var_b4; b2, var_b2; mc1, var_mc1; cp, var_cp;
        mr, var_mr; b1, var_b1; b3, var_b3] abs_3_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool mc1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a1, r2) in
        f_TL_bool (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a2, r3) in
      abs_2 b3 b1 b2 b4 b5 mr cp (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

  and abs_4 b3 b1 b2 mr cp mc1 b4 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b4, var_b4; mc1, var_mc1; b2, var_b2; cp, var_cp; mr, var_mr;
        b1, var_b1; b3, var_b3] abs_4_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mc1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_3 b3 b1 b2 b4 mr cp mc1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_5 b1 b2 mr cp mc1 b3 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mc1, var_mc1; b2, var_b2; b3, var_b3; cp, var_cp; mr, var_mr;
        b1, var_b1] abs_5_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mc1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_4 b3 b1 b2 mr cp mc1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_6 b1 b2 cp mc1 mr opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mc1, var_mc1; b2, var_b2; mr, var_mr; cp, var_cp;
        b1, var_b1] abs_6_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mc1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_5 b1 b2 mr cp mc1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_7 b1 cp mc1 mr1 b2 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mc1, var_mc1; b2, var_b2; mr1, var_mr1; cp, var_cp; b1, var_b1]
   abs_7_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool mr1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      abs_6 b1 b2 cp mc1 (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and abs_8 cp mc1 mr1 b1 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [mc1, var_mc1; mr1, var_mr1; b1, var_b1; cp, var_cp] abs_8_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_7 b1 cp mc1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_9 b1 b2 b3 opt_th =
    let base_th =
      trans_opt opt_th (INST [b3, var_b3; b2, var_b2; b1, var_b1] abs_9_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a3, Comb (Comb (a1, _), a2)), a4), a5)) ->
      let r1 =
        if is_true_th (REFL b1) then
          let th0 = MK_COMB (MK_COMB (REFL a1, REFL b1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_OR in
          TRANS th0 th1
        else
          let a2_eq =
            if is_true_th (REFL b2) then
              let th0 = MK_COMB (MK_COMB (REFL a1, REFL b2), REFL b3) in
              let th1 = INST[b3, p_var_bool] T_OR in
              TRANS th0 th1
            else
              let th0 = MK_COMB (MK_COMB (REFL a1, REFL b2), REFL b3) in
              let th1 = INST[b3, p_var_bool] F_OR in
              TRANS th0 th1 in
          let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
          TRANS (MK_COMB (MK_COMB (REFL a1, REFL b1), a2_eq)) or_th in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r1), REFL a4), REFL a5) in
        let th1 = INST [(a4, var_t1); (a5, var_e1)] COND_cpstep_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r1), REFL a4), REFL a5) in
        let th1 = INST [(a4, var_t1); (a5, var_e1)] COND_cpstep_list_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and abs_10 b1 mr1 b2 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [b2, var_b2; mr1, var_mr1; b1, var_b1] abs_10_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_9 b1 b2 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_11 mr1 b1 opt_th =
    let base_th =
      trans_opt opt_th (INST [mr1, var_mr1; b1, var_b1] abs_11_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_10 b1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_12 b1 b2 b3 mr cp mc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b3, var_b3; mc, var_mc; cp, var_cp; mr, var_mr; b2, var_b2; b1, var_b1]
   abs_12_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (Comb (a1, _), _)), a8),
 (Comb (Comb (a7, Comb (Comb (Comb (a3, _), a4), a5)), Comb
        (Comb (Comb (_, a6), _), _)) as a9))) ->
      let r1 =
        if is_true_th (REFL b1) then
          let th0 = MK_COMB (MK_COMB (REFL a1, REFL b1), REFL b2) in
          let th1 = INST[b2, p_var_bool] T_OR in
          TRANS th0 th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, REFL b1), REFL b2) in
          let th1 = INST[b2, p_var_bool] F_OR in
          TRANS th0 th1 in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
        let th1 = INST [(a8, var_t1); (a9, var_e1)] COND_cpstep_list_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        f_cfctr_map a6 mc cp (Some base_th)
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
        let th1 = INST [(a8, var_t1); (a9, var_e1)] COND_cpstep_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 =
          if is_true_th (REFL b3) then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a3, REFL b3), REFL a4), REFL a5)
                in
            let th1 = INST [(a4, var_t); (a5, var_e)] COND_cpstep_T in
            TRANS th0 th1
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a3, REFL b3), REFL a4), REFL a5)
                in
            let th1 = INST [(a4, var_t); (a5, var_e)] COND_cpstep_F in
            TRANS th0 th1 in
        let r3 = f_cfctr_map a6 mc cp None in
        TRANS base_th (MK_COMB (MK_COMB (REFL a7, r2), r3))
    | _ -> failwith "bad pattern"

  and abs_13 b1 b2 mr cp mc1 b3 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b3, var_b3; cp, var_cp; mr, var_mr; mc1, var_mc1; b2, var_b2;
        b1, var_b1] abs_13_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_TL_bool mc1 None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_12 b1 b2 b3 mr cp (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_14 b1 b2 cp mc1 mr opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mr, var_mr; mc1, var_mc1; cp, var_cp; b2, var_b2; b1, var_b1]
   abs_14_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_HD_bool mc1 None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_13 b1 b2 mr cp mc1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_15 b1 cp mc1 mr1 b2 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mc1, var_mc1; cp, var_cp; b2, var_b2; mr1, var_mr1; b1, var_b1]
   abs_15_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool mr1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      abs_14 b1 b2 cp mc1 (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and abs_16 cp mc1 mr1 b1 opt_th =
    let base_th =
      trans_opt opt_th
       (INST [mr1, var_mr1; mc1, var_mc1; cp, var_cp; b1, var_b1] abs_16_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_15 b1 cp mc1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_17 b opt_th =
    let base_th = trans_opt opt_th (INST [b, var_b] abs_17_th) in
    f_NOT b (Some base_th)
  and abs_18 i mc1 cp mr opt_th =
    let base_th =
      trans_opt opt_th
        (INST [mr, var_mr; cp, var_cp; mc1, var_mc1; i, var_i] abs_18_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (a5, Comb (a4, Comb (a3, Comb
                                           ((Comb (_, a1) as a2), _)))), _)) ->
      let r1 = (a1, abs_17) in
      let r2 = f_take_list_bool i mr None in
      let r3 =
        let r3 = MK_COMB (REFL a2, r2) in
        f_FILTER_bool r1 (rand (concl r2)) (Some r3) in
      let r4 =
        let r4 = MK_COMB (REFL a3, r3) in
        f_LENGTH_bool (rand (concl r3)) (Some r4) in
      let r5 = MK_COMB (REFL a4, r4) in
      let r6 = f_cfctr_map mr mc1 cp None in
      TRANS base_th (MK_COMB (MK_COMB (REFL a5, r5), r6))
    | _ -> failwith "bad pattern"

  and f_cfctr_map tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (mr1, mc1, Const ("NIL", _)) ->
      trans_opt opt_th
        (INST [mc1, var_mc1; mr1, var_mr1] CFCTR_MAP_CASES_case1)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Comb
                             (Const ("CpR", _), i)), cp)) ->
      let base_th =
        trans_opt opt_th
 (INST [i, var_i; cp, var_cp; mc1, var_mc1; mr1, var_mr1]
   CFCTR_MAP_CASES_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_rotr_list_bool i mr1 None in
        let r2 = MK_COMB (REFL a1, r1) in
        abs_18 i mc1 cp (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp)) ->
      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_MAP_CASES_case3)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp)) ->
      let base_th =
        trans_opt opt_th
       (INST [mr1, var_mr1; cp, var_cp; mc1, var_mc1] CFCTR_MAP_CASES_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)),
          (Comb (a3, Comb (Comb (_, a4), _)) as a6)), (Comb (a5, _) as a7))) ->
        let r1 = f_EQ_cpstep_list cp a1 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t1); (a7, var_e1)] COND_cpstep_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_EL_bool a4 mr1 None in
          let r3 = MK_COMB (REFL a3, r2) in
          abs_11 mr1 (rand (concl r2)) (Some (TRANS base_th r3))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t1); (a7, var_e1)] COND_cpstep_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_EL_bool a4 mr1 None in
          let r3 = MK_COMB (REFL a5, r2) in
          abs_16 cp mc1 mr1 (rand (concl r2)) (Some (TRANS base_th r3))
      | _ -> failwith "bad pattern"
      )
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp)) ->
      let base_th =
        trans_opt opt_th
       (INST [mc1, var_mc1; mr1, var_mr1; cp, var_cp] CFCTR_MAP_CASES_case5) in
      (match concl base_th with
      | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
        let r1 = f_EL_bool a1 mr1 None in
        let r2 = MK_COMB (REFL a2, r1) in
        abs_8 cp mc1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpU", _)), cp)) ->
      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_MAP_CASES_case6)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpK", _)), cp)) ->
      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_MAP_CASES_case7)
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpA", _)), cp)) ->
      trans_opt opt_th
        (INST [cp, var_cp; mc1, var_mc1; mr1, var_mr1] CFCTR_MAP_CASES_case8)
    | _ -> failwith "No match: f_cfctr_map"

   in
  f_cfctr_map
;;

let f_ALL_bool =
  let ALL_case1, ALL_case2 =
    match List.map standardize
  (inst_type_thms `:(bool->bool)->(bool)list->bool` (local_split_thm ALL)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_id_P = standardize_tm (mk_var ("P", `:bool->bool`)) in
  let var_h = standardize_tm (mk_var ("h", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let rec f_ALL_bool tm1 tm2 opt_th =
    match (tm1, tm2) with
    | ((id_P, func_id_P), Const ("NIL", _)) ->
      trans_opt opt_th (INST [id_P, var_id_P] ALL_case1)
    | ((id_P, func_id_P), Comb (Comb (Const ("CONS", _), h), t)) ->
      let base_th =
        trans_opt opt_th
          (INST [id_P, var_id_P; t, var_t; h, var_h] ALL_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = func_id_P h None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_ALL_bool (id_P, func_id_P) t (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_ALL_bool"
     in
  f_ALL_bool
;;

let f_nsp =
  let nsp_case1 =
    match List.map standardize (local_split_thm nsp) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:bool`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let var_x = standardize_tm (mk_var ("x", `:bool`)) in
  let var_y = standardize_tm (mk_var ("y", `:bool`)) in
  let COND_bool_T = standardize (INST_TYPE [`:bool`, aty] COND_T) in
  let COND_bool_F = standardize (INST_TYPE [`:bool`, aty] COND_F) in
  let rec f_nsp b x y opt_th =
    let base_th =
      trans_opt opt_th (INST [y, var_y; x, var_x; b, var_b] nsp_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a1, _), (Comb (Comb (a2, _), _) as a4)),
                     (Comb (Comb (a3, _), _) as a5))) ->
      if is_true_th (REFL b) then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL a4), REFL a5) in
        let th1 = INST [(a4, var_t); (a5, var_e)] COND_bool_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        if is_true_th (REFL x) then
          let th0 = MK_COMB (MK_COMB (REFL a2, REFL x), REFL y) in
          let th1 = INST[y, p_var_bool] T_OR in
          TRANS (TRANS base_th th0) th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a2, REFL x), REFL y) in
          let th1 = INST[y, p_var_bool] F_OR in
          TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL a4), REFL a5) in
        let th1 = INST [(a4, var_t); (a5, var_e)] COND_bool_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        if is_true_th (REFL x) then
          let th0 = MK_COMB (MK_COMB (REFL a3, REFL x), REFL y) in
          let th1 = INST[y, p_var_bool] T_AND in
          TRANS (TRANS base_th th0) th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a3, REFL x), REFL y) in
          let th1 = INST[y, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
  f_nsp
;;

let f_cfctr_ok =
  let CFCTR_OK_CASES_case1, CFCTR_OK_CASES_case2, CFCTR_OK_CASES_case3,
 CFCTR_OK_CASES_case4, CFCTR_OK_CASES_case5, CFCTR_OK_CASES_case6,
   CFCTR_OK_CASES_case7, CFCTR_OK_CASES_case8 =
    match List.map standardize (local_split_thm CFCTR_OK_CASES) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:bool`)) in
  let var_mr1 = standardize_tm (mk_var ("mr", `:(bool)list`)) in
  let var_mc1 = standardize_tm (mk_var ("mc", `:(bool)list`)) in
  let var_cp = standardize_tm (mk_var ("cp'", `:(cpstep)list`)) in
  let var_i = standardize_tm (mk_var ("i", `:num`)) in
  let var_b1 = standardize_tm (mk_var ("b1", `:bool`)) in
  let var_b2 = standardize_tm (mk_var ("b2", `:bool`)) in
  let var_mr = standardize_tm (mk_var ("mr'", `:(bool)list`)) in
  let var_b3 = standardize_tm (mk_var ("b3", `:bool`)) in
  let var_mc = standardize_tm (mk_var ("mc'", `:(bool)list`)) in
  let var_b4 = standardize_tm (mk_var ("b4", `:bool`)) in
  let var_b5 = standardize_tm (mk_var ("b5", `:bool`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblblblblblblbrlrrrrlr" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrlrrrrlrb"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_2_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblblblblblbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_3_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblblblblbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrrllrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_4_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblblblbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrrllrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_5_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblblbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblblrrrllr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_6_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlblbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrrllrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_7_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlbl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrlrrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_8_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrl" (concl CFCTR_OK_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case5))
   ["rrrlblblblblblblbrlrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_9_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlrrlblbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblbrllrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_10_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlrrlbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblblrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_11_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlrrl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblblrrllr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_12_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrlblblblbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblbrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_13_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrlblblbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblbrllrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_14_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrlblbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblbrllrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_15_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrlbl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblblrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_16_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrl" (concl CFCTR_OK_CASES_case4),
 List.map (C follow_full_path (concl CFCTR_OK_CASES_case4))
   ["rrrrlblblblblblrrllr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_bool_T = standardize (INST_TYPE [`:bool`, aty] COND_T) in
  let COND_bool_F = standardize (INST_TYPE [`:bool`, aty] COND_F) in
  let rec abs_1 b opt_th =
    trans_opt opt_th (INST [b, var_b] abs_1_th)
  and abs_2 b3 b1 b2 b4 b5 mr cp mc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mr, var_mr; b5, var_b5; b4, var_b4; b2, var_b2; b1, var_b1; b3, var_b3;
        mc, var_mc; cp, var_cp] abs_2_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (a7, Comb (_, Comb (Comb (a1, _), a2))),
 (Comb (Comb (_, Comb (a6, Comb (_, (Comb (_, (Comb (Comb (_, a3), _) as a4))
              as a5)))), (Comb (Comb (Comb (_, a8), _), _) as a9)) as a10))) ->
      let r1 = f_nsp b3 b1 b4 None in
      let r2 =
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_OR in
          TRANS th0 th1
        else
          let a2_eq = f_nsp b3 b2 b5 None in
          let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
          TRANS (MK_COMB (MK_COMB (REFL a1, r1), a2_eq)) or_th in
      let r3 =
        let r3 = MK_COMB (REFL a6, r2) in
        f_NOT (rand (concl r2)) (Some r3) in
      if is_true_th r3 then
        let th0 = MK_COMB (MK_COMB (REFL a7, r3), REFL a10) in
        let th1 = INST[a10, p_var_bool] T_AND in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r4 =
          if is_true_th (REFL b1) then
            let a2_eq =
              if is_true_th (REFL b2) then
                let a2_eq =
                  let r4 = (a3, abs_1) in
                  f_ALL_bool r4 mr None in
                let and_th = INST[rand (concl a2_eq), p_var_bool] T_AND in
                TRANS (MK_COMB (MK_COMB (REFL a7, REFL b2), a2_eq)) and_th
              else
                let th0 = MK_COMB (MK_COMB (REFL a7, REFL b2), REFL a4) in
                let th1 = INST[a4, p_var_bool] F_AND in
                TRANS th0 th1 in
            let and_th = INST[rand (concl a2_eq), p_var_bool] T_AND in
            TRANS (MK_COMB (MK_COMB (REFL a7, REFL b1), a2_eq)) and_th
          else
            let th0 = MK_COMB (MK_COMB (REFL a7, REFL b1), REFL a5) in
            let th1 = INST[a5, p_var_bool] F_AND in
            TRANS th0 th1 in
        let r5 =
          let r5 = MK_COMB (REFL a6, r4) in
          f_NOT (rand (concl r4)) (Some r5) in
        if is_true_th r5 then
          let th0 = MK_COMB (MK_COMB (REFL a7, r5), REFL a9) in
          let th1 = INST[a9, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_cfctr_ok a8 mc cp (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a7, r5), REFL a9) in
          let th1 = INST[a9, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      else
        let th0 = MK_COMB (MK_COMB (REFL a7, r3), REFL a10) in
        let th1 = INST[a10, p_var_bool] F_AND in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and abs_3 b3 b1 b2 b4 mr cp mc1 b5 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b5, var_b5; mr, var_mr; b4, var_b4; b2, var_b2; b1, var_b1; b3, var_b3;
        mc1, var_mc1; cp, var_cp] abs_3_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool mc1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a1, r2) in
        f_TL_bool (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a2, r3) in
      abs_2 b3 b1 b2 b4 b5 mr cp (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

  and abs_4 b3 b1 b2 mr cp mc1 b4 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b4, var_b4; mc1, var_mc1; mr, var_mr; b2, var_b2; b1, var_b1;
        b3, var_b3; cp, var_cp] abs_4_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mc1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_3 b3 b1 b2 b4 mr cp mc1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_5 b1 b2 mr cp mc1 b3 opt_th =
