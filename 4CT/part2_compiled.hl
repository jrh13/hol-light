      list_mk_comb
 (follow_full_path "rrlblblblbl" (concl CPTRIAD_NUM_case1),
 List.map (C follow_full_path (concl CPTRIAD_NUM_case1)) ["rrlblblblblbrrlr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_5_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlblblbl" (concl CPTRIAD_NUM_case1),
 List.map (C follow_full_path (concl CPTRIAD_NUM_case1)) ["rrlblblblblbrlrlr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_6_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlblbl" (concl CPTRIAD_NUM_case1),
 List.map (C follow_full_path (concl CPTRIAD_NUM_case1)) ["rrlblblblblbrrr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_7_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlbl" (concl CPTRIAD_NUM_case1),
 List.map (C follow_full_path (concl CPTRIAD_NUM_case1)) ["rrlblblblblbrlrr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_8_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrl" (concl CPTRIAD_NUM_case1),
   List.map (C follow_full_path (concl CPTRIAD_NUM_case1)) ["rrlbrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_bool_T = standardize (INST_TYPE [`:bool`, aty] COND_T) in
  let COND_bool_F = standardize (INST_TYPE [`:bool`, aty] COND_F) in
  let rec abs_1 b opt_th =
    let base_th = trans_opt opt_th (INST [b, var_b] abs_1_th) in
    f_NOT b (Some base_th)
  and abs_2 b opt_th =
    trans_opt opt_th (INST [b, var_b] abs_2_th)
  and abs_3 ccm cp i mct opt_th =
    let base_th =
      trans_opt opt_th
        (INST [mct, var_mct; i, var_i; cp, var_cp; ccm, var_ccm] abs_3_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a8, Comb (Comb (a2, Comb (Comb (_, a1), _)),
 (Comb ((Comb (_, a6) as a5), Comb (a4, Comb (Comb (_, a3), _))) as a7))),
   a11), (Comb (a10, Comb (_, a9)) as a12))) ->
      let r1 = (a1, abs_1) in
      let r2 = f_EX_bool r1 mct None in
      let r3 =
        if is_true_th r2 then
          let a2_eq =
            let r3 = (a3, abs_2) in
            let r4 = f_FILTER_bool r3 mct None in
            let r5 =
              let r5 = MK_COMB (REFL a4, r4) in
              f_LENGTH_bool (rand (concl r4)) (Some r5) in
            let r6 = MK_COMB (REFL a5, r5) in
            conv_LT a6 (rand (concl r5)) (Some r6) in
          let and_th = INST[rand (concl a2_eq), p_var_bool] T_AND in
          TRANS (MK_COMB (MK_COMB (REFL a2, r2), a2_eq)) and_th
        else
          let th0 = MK_COMB (MK_COMB (REFL a2, r2), REFL a7) in
          let th1 = INST[a7, p_var_bool] F_AND in
          TRANS th0 th1 in
      if is_true_th r3 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a8, r3), REFL a11), REFL a12) in
        let th1 = INST [(a11, var_t); (a12, var_e)] COND_bool_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a8, r3), REFL a11), REFL a12) in
        let th1 = INST [(a11, var_t); (a12, var_e)] COND_bool_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r4 = conv_SUB i a9 None in
        let r5 = MK_COMB (REFL a10, r4) in
        f_cptriad ccm cp (rand (concl r4)) (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"

  and abs_4 ccm cp i mrc mrt mkt mkc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mkc, var_mkc; mkt, var_mkt; mrt, var_mrt; mrc, var_mrc; i, var_i;
        cp, var_cp; ccm, var_ccm] abs_4_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (a1, _), _))) ->
      let r1 = f_mask_list_bool mrc mrt None in
      let r2 = f_mask_list_bool mkc mkt None in
      let r3 =
        let r3 = MK_COMB (MK_COMB (REFL a1, r1), r2) in
        f_APPEND_bool (rand (concl r1)) (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a2, r3) in
      abs_3 ccm cp i (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

  and abs_5 cp i mrt mkt ccm mrc opt_th =
    let base_th =
      trans_opt opt_th
 (INST [ccm, var_ccm; mrc, var_mrc; mkt, var_mkt; mrt, var_mrt; i, var_i;
        cp, var_cp] abs_5_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_SND_bool_list_bool_list ccm None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_4 ccm cp i mrc mrt mkt (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_6 cp i mrt ccm mkt opt_th =
    let base_th =
      trans_opt opt_th
 (INST [ccm, var_ccm; mkt, var_mkt; mrt, var_mrt; i, var_i; cp, var_cp]
   abs_6_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_FST_bool_list_bool_list ccm None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_5 cp i mrt mkt ccm (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_7 cp i ccm adjm mrt opt_th =
    let base_th =
      trans_opt opt_th
 (INST [ccm, var_ccm; mrt, var_mrt; adjm, var_adjm; i, var_i; cp, var_cp]
   abs_7_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_SND_bool_list_bool_list adjm None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_6 cp i mrt ccm (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_8 cp i ccm adjm opt_th =
    let base_th =
      trans_opt opt_th
        (INST [ccm, var_ccm; adjm, var_adjm; i, var_i; cp, var_cp] abs_8_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_FST_bool_list_bool_list adjm None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_7 cp i ccm adjm (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and f_cptriad ccm cp i opt_th =
    let base_th =
      trans_opt opt_th
        (INST [i, var_i; cp, var_cp; ccm, var_ccm] CPTRIAD_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a7),
           (Comb (a6, Comb (Comb (a5, Comb (a4, Comb (_, a3))), _)) as a8))) ->
      let r1 = conv_EQ_num i a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a7), REFL a8) in
        let th1 = INST [(a7, var_t); (a8, var_e)] COND_bool_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a7), REFL a8) in
        let th1 = INST [(a7, var_t); (a8, var_e)] COND_bool_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB i a3 None in
        let r3 =
          let r3 = MK_COMB (REFL a4, r2) in
          f_cfmask1 cp (rand (concl r2)) (Some r3) in
        let r4 =
          let r4 = MK_COMB (MK_COMB (REFL a5, r3), REFL cp) in
          f_cpadj (rand (concl r3)) cp (Some r4) in
        let r5 = MK_COMB (REFL a6, r4) in
        abs_8 cp i ccm (rand (concl r4)) (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"

   in
  f_cptriad
;;

let f_ctrband =
  let CTRBAND_CASES_case1, CTRBAND_CASES_case2, CTRBAND_CASES_case3,
 CTRBAND_CASES_case4, CTRBAND_CASES_case5, CTRBAND_CASES_case6,
   CTRBAND_CASES_case7, CTRBAND_CASES_case8 =
    match List.map standardize (local_split_thm CTRBAND_CASES) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(bool)list#(bool)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list#(bool)list`)) in
  let var_cm1 = standardize_tm (mk_var ("cm", `:(bool)list`)) in
  let var_cp = standardize_tm (mk_var ("cp'", `:(cpstep)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_r = standardize_tm (mk_var ("r", `:(bool)list#(bool)list`)) in
  let var_b1 = standardize_tm (mk_var ("b1", `:bool`)) in
  let var_cm = standardize_tm (mk_var ("cm'", `:(bool)list`)) in
  let var_res = standardize_tm (mk_var ("res", `:(bool)list#(bool)list`)) in
  let var_mr = standardize_tm (mk_var ("mr", `:(bool)list`)) in
  let var_mk = standardize_tm (mk_var ("mk", `:(bool)list`)) in
  let var_b0 = standardize_tm (mk_var ("b0", `:bool`)) in
  let var_b2 = standardize_tm (mk_var ("b2", `:bool`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblblblblblbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5))
   ["rlblblblblblblblrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_2_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblblblblbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5))
   ["rlblblblblblblblrrlrrrrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_3_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblblblbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5)) ["rlblblblblbrr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_4_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblblbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5)) ["rlblblblbrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_5_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5))
   ["rlblblblblblblblrrlrrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_6_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlbl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5))
   ["rlblblblblblblblrrlrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_7_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl CTRBAND_CASES_case5),
 List.map (C follow_full_path (concl CTRBAND_CASES_case5))
   ["rlblblblblblblblrrlrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_8_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlblblblbl" (concl CTRBAND_CASES_case4),
 List.map (C follow_full_path (concl CTRBAND_CASES_case4)) ["rrlblblblblblrr"])
   in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_9_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlblblbl" (concl CTRBAND_CASES_case4),
 List.map (C follow_full_path (concl CTRBAND_CASES_case4))
   ["rrlblblblblblrlrrrrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_10_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlblbl" (concl CTRBAND_CASES_case4),
   List.map (C follow_full_path (concl CTRBAND_CASES_case4)) ["rrlblblbrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_11_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlbl" (concl CTRBAND_CASES_case4),
   List.map (C follow_full_path (concl CTRBAND_CASES_case4)) ["rrlblbrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_12_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrl" (concl CTRBAND_CASES_case4),
 List.map (C follow_full_path (concl CTRBAND_CASES_case4))
   ["rrlblblblblblrlrrrlrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_13_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl CTRBAND_CASES_case2),
   List.map (C follow_full_path (concl CTRBAND_CASES_case2)) ["rlbrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_bool_list_bool_list_T =
    standardize (INST_TYPE [`:(bool)list#(bool)list`, aty] COND_T) in
  let COND_bool_list_bool_list_F =
    standardize (INST_TYPE [`:(bool)list#(bool)list`, aty] COND_F) in
  let rec abs_1 b0 b1 b2 mr mk opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mr, var_mr; b2, var_b2; b1, var_b1; b0, var_b0;
        mk, var_mk] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a3, Comb ((Comb (_, a2) as a1), _)),
 (Comb (Comb (a14, Comb (Comb (a13, Comb (_, a4)), Comb
 (a7, Comb (Comb (_, Comb (Comb (a8, _), a5)), _)))),
 Comb (Comb (_, Comb (_, (Comb (_, (Comb (_, (Comb (a9, Comb (a6, _)) as a10))
                                    as a11)) as a12))), _)) as a15)), a16)) ->
      let r1 = f_LENGTH_bool mr None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        conv_LE a2 (rand (concl r1)) (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a15), REFL a16) in
        let th1 =
          INST [(a15, var_t); (a16, var_e)] COND_bool_list_bool_list_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 =
          if is_true_th (REFL b0) then
            let th0 = MK_COMB (MK_COMB (REFL a8, REFL b0), REFL a4) in
            let th1 = INST[a4, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq = f_HD_bool mr None in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a8, REFL b0), a2_eq)) or_th in
        let r4 =
          if is_true_th (REFL b2) then
            let th0 = MK_COMB (MK_COMB (REFL a8, REFL b2), REFL a5) in
            let th1 = INST[a5, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq =
              let r4 = f_TL_bool mr None in
              let r5 =
                let r5 = MK_COMB (REFL a6, r4) in
                f_TL_bool (rand (concl r4)) (Some r5) in
              let r6 = MK_COMB (REFL a9, r5) in
              f_HD_bool (rand (concl r5)) (Some r6) in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a8, REFL b2), a2_eq)) or_th in
        let r5 = f_TL_bool mr None in
        let r6 =
          let r6 = MK_COMB (REFL a6, r5) in
          f_TL_bool (rand (concl r5)) (Some r6) in
        let r7 =
          let r7 = MK_COMB (REFL a6, r6) in
          f_TL_bool (rand (concl r6)) (Some r7) in
        let r8 = MK_COMB (MK_COMB (REFL a13, r4), r7) in
        let r9 = MK_COMB (REFL a7, r8) in
        let r10 = MK_COMB (MK_COMB (REFL a13, r3), r9) in
        let r11 =
          if is_true_th (REFL b0) then
            let th0 = MK_COMB (MK_COMB (REFL a8, REFL b0), REFL a12) in
            let th1 = INST[a12, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq =
              if is_true_th (REFL b1) then
                let th0 = MK_COMB (MK_COMB (REFL a8, REFL b1), REFL a11) in
                let th1 = INST[a11, p_var_bool] T_OR in
                TRANS th0 th1
              else
                let a2_eq =
                  if is_true_th (REFL b2) then
                    let th0 =
                      MK_COMB (MK_COMB (REFL a8, REFL b2), REFL a10) in
                    let th1 = INST[a10, p_var_bool] T_OR in
                    TRANS th0 th1
                  else
                    let a2_eq =
                      let r11 = MK_COMB (REFL a9, r5) in
                      f_HD_bool (rand (concl r5)) (Some r11) in
                    let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
                    TRANS (MK_COMB (MK_COMB (REFL a8, REFL b2), a2_eq)) or_th
                      in
                let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
                TRANS (MK_COMB (MK_COMB (REFL a8, REFL b1), a2_eq)) or_th in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a8, REFL b0), a2_eq)) or_th in
        let r12 = MK_COMB (MK_COMB (REFL a13, r11), REFL mk) in
        TRANS base_th (MK_COMB (MK_COMB (REFL a14, r10), r12))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a15), REFL a16) in
        let th1 =
          INST [(a15, var_t); (a16, var_e)] COND_bool_list_bool_list_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and abs_2 b0 b1 b2 res mr opt_th =
    let base_th =
      trans_opt opt_th
 (INST [mr, var_mr; b2, var_b2; b1, var_b1; b0, var_b0;
        res, var_res] abs_2_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_SND_bool_list_bool_list res None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_1 b0 b1 b2 mr (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_3 b0 b1 b2 res opt_th =
    let base_th =
      trans_opt opt_th
        (INST [res, var_res; b2, var_b2; b1, var_b1; b0, var_b0] abs_3_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_FST_bool_list_bool_list res None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_2 b0 b1 b2 res (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_4 b0 b1 b2 cp cm opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b2, var_b2; b1, var_b1; b0, var_b0; cm, var_cm;
        cp, var_cp] abs_4_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_ctrband cm cp None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_3 b0 b1 b2 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_5 b0 b1 cp cm1 b2 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b2, var_b2; b1, var_b1; b0, var_b0; cm1, var_cm1;
        cp, var_cp] abs_5_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool cm1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a1, r2) in
        f_TL_bool (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a2, r3) in
      abs_4 b0 b1 b2 cp (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

  and abs_6 b1 cp cm1 b0 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [b0, var_b0; cm1, var_cm1; b1, var_b1; cp, var_cp] abs_6_th) in
    match concl base_th with
    | Comb (_, Comb (a3, Comb (a2, Comb (a1, _)))) ->
      let r1 = f_TL_bool cm1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a2, r2) in
        f_HD_bool (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a3, r3) in
      abs_5 b0 b1 cp cm1 (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

  and abs_7 cp cm1 b1 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [cm1, var_cm1; b1, var_b1; cp, var_cp] abs_7_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_TL_bool cm1 None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_HD_bool (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      abs_6 b1 cp cm1 (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and abs_8 b1 mr mk opt_th =
    let base_th =
      trans_opt opt_th (INST [mr, var_mr; b1, var_b1; mk, var_mk] abs_8_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a3, Comb ((Comb (_, a2) as a1), _)),
 (Comb (Comb (a11, Comb (Comb (_, Comb (_, (Comb (a6, _) as a4))), Comb
 (a9, Comb (Comb (a10, Comb (Comb (a5, _), a7)), Comb (a8, _))))), _) as a12)),
   a13)) ->
      let r1 = f_LENGTH_bool mr None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        conv_LE a2 (rand (concl r1)) (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a12), REFL a13) in
        let th1 =
          INST [(a12, var_t); (a13, var_e)] COND_bool_list_bool_list_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 =
          if is_true_th (REFL b1) then
            let th0 = MK_COMB (MK_COMB (REFL a5, REFL b1), REFL a4) in
            let th1 = INST[a4, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq = f_HD_bool mr None in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a5, REFL b1), a2_eq)) or_th in
        let r4 =
          if is_true_th (REFL b1) then
            let th0 = MK_COMB (MK_COMB (REFL a5, REFL b1), REFL a7) in
            let th1 = INST[a7, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq =
              let r4 = f_TL_bool mr None in
              let r5 = MK_COMB (REFL a6, r4) in
              f_HD_bool (rand (concl r4)) (Some r5) in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a5, REFL b1), a2_eq)) or_th in
        let r5 = f_TL_bool mr None in
        let r6 =
          let r6 = MK_COMB (REFL a8, r5) in
          f_TL_bool (rand (concl r5)) (Some r6) in
        let r7 = MK_COMB (MK_COMB (REFL a10, r4), r6) in
        let r8 = MK_COMB (REFL a9, r7) in
        let r9 = MK_COMB (MK_COMB (REFL a10, r3), r8) in
        TRANS base_th (MK_COMB (MK_COMB (REFL a11, r9), REFL mk))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a12), REFL a13) in
        let th1 =
          INST [(a12, var_t); (a13, var_e)] COND_bool_list_bool_list_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and abs_9 b1 res mr opt_th =
    let base_th =
      trans_opt opt_th
        (INST [mr, var_mr; b1, var_b1; res, var_res] abs_9_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_SND_bool_list_bool_list res None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_8 b1 mr (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_10 b1 res opt_th =
    let base_th =
      trans_opt opt_th (INST [res, var_res; b1, var_b1] abs_10_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_FST_bool_list_bool_list res None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_9 b1 res (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_11 b1 cp cm opt_th =
    let base_th =
      trans_opt opt_th (INST [b1, var_b1; cm, var_cm; cp, var_cp] abs_11_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_ctrband cm cp None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_10 b1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_12 cp cm1 b1 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [b1, var_b1; cm1, var_cm1; cp, var_cp] abs_12_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_TL_bool cm1 None in
      let r2 = MK_COMB (REFL a1, r1) in
      abs_11 b1 cp (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_13 n r opt_th =
    let base_th = trans_opt opt_th (INST [r, var_r; n, var_n] abs_13_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (a2, Comb (a1, _)), _)) ->
      let r1 = f_FST_bool_list_bool_list r None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_rot_list_bool n (rand (concl r1)) (Some r2) in
      let r3 = f_SND_bool_list_bool_list r None in
      TRANS base_th (MK_COMB (MK_COMB (REFL a2, r2), r3))
    | _ -> failwith "bad pattern"

  and f_ctrband tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (cm1, Const ("NIL", _)) ->
      trans_opt opt_th (INST [cm1, var_cm1] CTRBAND_CASES_case1)
    | (cm1, Comb (Comb (Const ("CONS", _), Comb (Const ("CpR", _), n)), cp)) ->
      let base_th =
        trans_opt opt_th
          (INST [cp, var_cp; n, var_n; cm1, var_cm1] CTRBAND_CASES_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_ctrband cm1 cp None in
        let r2 = MK_COMB (REFL a1, r1) in
        abs_13 n (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp)) ->
      trans_opt opt_th (INST [cp, var_cp; cm1, var_cm1] CTRBAND_CASES_case3)
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp)) ->
      let base_th =
        trans_opt opt_th
          (INST [cp, var_cp; cm1, var_cm1] CTRBAND_CASES_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)),
 (Comb (Comb (a5, Comb (Comb (_, a3), a4)), a6) as a8)), (Comb (a7, _) as a9)))
   ->
        let r1 = f_EQ_cpstep_list cp a1 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
          let th1 =
            INST [(a8, var_t); (a9, var_e)] COND_bool_list_bool_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_REPLICATE_bool a3 a4 None in
          TRANS base_th (MK_COMB (MK_COMB (REFL a5, r2), REFL a6))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
          let th1 =
            INST [(a8, var_t); (a9, var_e)] COND_bool_list_bool_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_HD_bool cm1 None in
          let r3 = MK_COMB (REFL a7, r2) in
          abs_12 cp cm1 (rand (concl r2)) (Some (TRANS base_th r3))
      | _ -> failwith "bad pattern"
      )
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp)) ->
      let base_th =
        trans_opt opt_th
          (INST [cm1, var_cm1; cp, var_cp] CTRBAND_CASES_case5) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_HD_bool cm1 None in
        let r2 = MK_COMB (REFL a1, r1) in
        abs_7 cp cm1 (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpU", _)), cp)) ->
      trans_opt opt_th (INST [cp, var_cp; cm1, var_cm1] CTRBAND_CASES_case6)
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpK", _)), cp)) ->
      trans_opt opt_th (INST [cp, var_cp; cm1, var_cm1] CTRBAND_CASES_case7)
    | (cm1, Comb (Comb (Const ("CONS", _), Const ("CpA", _)), cp)) ->
      trans_opt opt_th (INST [cp, var_cp; cm1, var_cm1] CTRBAND_CASES_case8)
    | _ -> failwith "No match: f_ctrband"

   in
  f_ctrband
;;

let f_valid_ctrm =
  let valid_ctrm_case1 =
    match List.map standardize (local_split_thm valid_ctrm) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:bool`)) in
  let var_cm = standardize_tm (mk_var ("cm", `:(bool)list`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrlr" (concl valid_ctrm_case1),
   List.map (C follow_full_path (concl valid_ctrm_case1)) ["rrrlrb"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_2_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rl" (concl valid_ctrm_case1),
   List.map (C follow_full_path (concl valid_ctrm_case1)) ["rlbrrlr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_bool_T = standardize (INST_TYPE [`:bool`, aty] COND_T) in
  let COND_bool_F = standardize (INST_TYPE [`:bool`, aty] COND_F) in
  let rec abs_1 b opt_th =
    trans_opt opt_th (INST [b, var_b] abs_1_th)
  and abs_2 cm cp n opt_th =
    let base_th =
      trans_opt opt_th (INST [n, var_n; cp, var_cp; cm, var_cm] abs_2_th) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), (Comb
 (Comb (Comb (a3, _), _), _) as a8)),
   (Comb (Comb (a5, Comb (Comb (_, a4), _)), (Comb (_, a6) as a7)) as a9))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
        let th1 = INST [(a8, var_t); (a9, var_e)] COND_bool_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_ctrband cm cp None in
        let r3 = f_cpksize cp None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL cp), r3) in
        f_cptriad (rand (concl r2)) cp (rand (concl r3))
          (Some (TRANS base_th r4))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a8), REFL a9) in
        let th1 = INST [(a8, var_t); (a9, var_e)] COND_bool_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_LT a4 n None in
        if is_true_th r2 then
          let th0 = MK_COMB (MK_COMB (REFL a5, r2), REFL a7) in
          let th1 = INST[a7, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          conv_LE n a6 (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a5, r2), REFL a7) in
          let th1 = INST[a7, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"

  and f_valid_ctrm cm cp opt_th =
    let base_th =
      trans_opt opt_th (INST [cp, var_cp; cm, var_cm] valid_ctrm_case1) in
    match concl base_th with
    | Comb (_, Comb (a3, Comb (a2, Comb (Comb (_, a1), _)))) ->
      let r1 = (a1, abs_1) in
      let r2 = f_FILTER_bool r1 cm None in
      let r3 =
        let r3 = MK_COMB (REFL a2, r2) in
        f_LENGTH_bool (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (REFL a3, r3) in
      abs_2 cm cp (rand (concl r3)) (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

   in
  f_valid_ctrm
;;

let f_contract_ctree_opt =
  let contract_ctree_opt_case1, contract_ctree_opt_case2 =
    match List.map standardize (local_split_thm contract_ctree_opt) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(ctree)option`)) in
  let var_t = standardize_tm (mk_var ("t", `:(ctree)option`)) in
  let var_cm = standardize_tm (mk_var ("cm", `:(bool)list`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let var_cpc = standardize_tm (mk_var ("cpc", `:(cpstep)list`)) in
  let COND_ctree_option_T =
    standardize (INST_TYPE [`:(ctree)option`, aty] COND_T) in
  let COND_ctree_option_F =
    standardize (INST_TYPE [`:(ctree)option`, aty] COND_F) in
  let rec f_contract_ctree_opt tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (cm, cp, Const ("NONE", _)) ->
      trans_opt opt_th (INST [cp, var_cp; cm, var_cm] contract_ctree_opt_case1)
    | (cm, cp, Comb (Const ("SOME", _), cpc)) ->
      let base_th =
        trans_opt opt_th
      (INST [cpc, var_cpc; cp, var_cp; cm, var_cm] contract_ctree_opt_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), (Comb (a2, _) as a3)), a4)) ->
        let r1 = f_valid_ctrm cm cp None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_ctree_option_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_cpcolor cpc None in
          TRANS base_th (MK_COMB (REFL a2, r2))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_ctree_option_F in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_contract_ctree_opt"
     in
  f_contract_ctree_opt
;;

