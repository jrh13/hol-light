        let r1 = f_ctrmsize cp None in
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        conv_ADD (rand (concl r1)) a2 (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpU", _)), cp) ->
      trans_opt opt_th (INST [cp, var_cp] CTRMSIZE_CASES_case6)
    | Comb (Comb (Const ("CONS", _), Const ("CpK", _)), cp) ->
      trans_opt opt_th (INST [cp, var_cp] CTRMSIZE_CASES_case7)
    | Comb (Comb (Const ("CONS", _), Const ("CpA", _)), cp) ->
      trans_opt opt_th (INST [cp, var_cp] CTRMSIZE_CASES_case8)
    | _ -> failwith "No match: f_ctrmsize"
     in
  f_ctrmsize
