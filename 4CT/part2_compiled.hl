            MK_COMB (MK_COMB (MK_COMB (REFL a3, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t1); (a7, var_e)] COND_gtree_pair_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_gtree_empty4 a2 None in
