    match (tm1, tm2, tm3, tm4, tm5) with
    | (Comb (Comb (Comb (Comb (Const ("GtreeNode", _), az), bz), cz), dz), b0,
       b1, x, Comb (Comb (Const (",", _), a), b)) ->
      trans_opt opt_th
 (INST [dz, var_dz; cz, var_cz; bz, var_bz; az, var_az; b, var_b; a, var_a;
        x, var_x; b1, var_b1; b0, var_b0] CS3_FO_case1)
    | (Const ("GtreeLeaf0", _), b0, b1, x, Comb (Comb (Const (",", _), a), b))
