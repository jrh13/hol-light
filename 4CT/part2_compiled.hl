      let r8 = f_SND_bool_list_bool_list res None in
      let r9 = MK_COMB (MK_COMB (REFL a11, r7), r8) in
      TRANS base_th (MK_COMB (MK_COMB (REFL a12, r6), r9))
    | _ -> failwith "bad pattern"

  and abs_2 a0 b1 mr1 b0 b11 res a1 opt_th =
    let base_th =
      trans_opt opt_th
 (INST [b11, var_b11; res, var_res; b0, var_b0; a1, var_a1; mr1, var_mr1;
        b1, var_b1; a0, var_a0] abs_2_th) in
