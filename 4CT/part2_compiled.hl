  let var_t0 = standardize_tm (mk_var ("t0'", `:gtree`)) in
  let var_t11 = standardize_tm (mk_var ("t1", `:gtree`)) in
  let var_t1 = standardize_tm (mk_var ("t1'", `:gtree`)) in
  let var_t2 = standardize_tm (mk_var ("t2", `:gtree`)) in
  let var_t3 = standardize_tm (mk_var ("t3", `:gtree`)) in
  let rec f_gtree_merge_pairs tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (Comb (Comb (Const ("GtreePair", _), t01), t0), Comb
 (Comb (Const ("GtreePair", _), t11), t1),
   Comb (Comb (Const ("GtreePair", _), t2), t3)) ->
      trans_opt opt_th
 (INST [t3, var_t3; t2, var_t2; t1, var_t1; t11, var_t11; t0, var_t0;
        t01, var_t01] gtree_merge_pairs_case1)
    | _ -> failwith "No match: f_gtree_merge_pairs"
     in
  f_gtree_merge_pairs
;;

let f_gtree_merge_line_fn =
  let gtree_merge_line_fn_eNx_case1 =
    match List.map standardize (local_split_thm gtree_merge_line_fn_eNx) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(gtree_pair)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(gtree_pair)list`)) in
  let var_d = standardize_tm (mk_var ("d", `:num`)) in
  let var_pt0 = standardize_tm (mk_var ("pt0", `:gtree_pair`)) in
  let var_pt1 = standardize_tm (mk_var ("pt1", `:gtree_pair`)) in
  let var_pt2 = standardize_tm (mk_var ("pt2", `:gtree_pair`)) in
  let var_lpt = standardize_tm (mk_var ("lpt", `:(gtree_pair)list`)) in
  let COND_gtree_pair_list_T =
    standardize (INST_TYPE [`:(gtree_pair)list`, aty] COND_T) in
  let COND_gtree_pair_list_F =
    standardize (INST_TYPE [`:(gtree_pair)list`, aty] COND_F) in
  let rec f_gtree_merge_line_fn d pt0 pt1 pt2 lpt opt_th =
    let base_th =
      trans_opt opt_th
 (INST [pt0, var_pt0; pt1, var_pt1; lpt, var_lpt; pt2, var_pt2; d, var_d]
   gtree_merge_line_fn_eNx_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a10),
 (Comb (_, Comb (Comb (_, (Comb (_, Comb (Comb (a9, Comb (Comb (_, a3), _)),
 a4)) as a7)),
 (Comb (Comb (Comb (Comb (Comb (a6, Comb (_, a5)), _), _), _), _) as a8)))
   as a11))) ->
      let r1 = conv_EQ_num d a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a10), REFL a11) in
        let th1 = INST [(a10, var_t); (a11, var_e)] COND_gtree_pair_list_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_gtree_merge_pairs pt0 pt1 pt2 None in
        TRANS base_th (MK_COMB (MK_COMB (REFL a9, r2), REFL a4))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a10), REFL a11) in
        let th1 = INST [(a10, var_t); (a11, var_e)] COND_gtree_pair_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_gtree_merge_pairs pt0 pt1 pt2 None in
        let r3 = f_EQ_gtree_pair_list lpt a4 None in
        let r4 =
          if is_true_th r3 then
            let cond_eq =
              let r4 = f_gtree_merge_pairs a3 pt0 pt1 None in
              let r5 = f_gtree_merge_pairs a3 a3 pt0 None in
              let r6 = MK_COMB (MK_COMB (REFL a9, r5), REFL a4) in
              MK_COMB (MK_COMB (REFL a9, r4), r6) in
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a2, r3), cond_eq), REFL a8) in
            let th1 =
              INST [(rand (concl cond_eq), var_t); (a8, var_e)]
                COND_gtree_pair_list_T in
            TRANS th0 th1
          else
            let cond_eq =
              let r4 = conv_SUB d a5 None in
              let r5 = f_HD_gtree_pair lpt None in
              let r6 = f_TL_gtree_pair lpt None in
              let r7 =
                MK_COMB (MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a6, r4), r5),
                                           REFL pt0), REFL pt1), r6) in
              f_gtree_merge_line_fn (rand (concl r4)) (rand (concl r5)) pt0 pt1
                (rand (concl r6)) (Some r7) in
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a2, r3), REFL a7), cond_eq) in
            let th1 =
              INST [(a7, var_t); (rand (concl cond_eq), var_e)]
                COND_gtree_pair_list_F in
            TRANS th0 th1 in
        TRANS base_th (MK_COMB (MK_COMB (REFL a9, r2), r4))
    | _ -> failwith "bad pattern"
     in
  f_gtree_merge_line_fn
;;

