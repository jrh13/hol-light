   CTREE_EMPTY_NODE_FO_case29 =
    match List.map standardize (local_split_thm CTREE_EMPTY_NODE_FO) with
    | [th1; th2; th3; th4; th5; th6; th7; th8; th9; th10; th11; th12; th13;
 th14; th15; th16; th17; th18; th19; th20; th21; th22; th23; th24; th25; th26;
 th27; th28; th29] ->
      (th1, th2, th3, th4, th5, th6, th7, th8, th9, th10, th11, th12, th13,
 th14, th15, th16, th17, th18, th19, th20, th21, th22, th23, th24, th25, th26,
   th27, th28, th29)
    | _ -> failwith "error"
     in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_l3 = standardize_tm (mk_var ("l3", `:ctree`)) in
  let var_a3 = standardize_tm (mk_var ("a3", `:ctree`)) in
  let var_b3 = standardize_tm (mk_var ("b3", `:ctree`)) in
  let var_c3 = standardize_tm (mk_var ("c3", `:ctree`)) in
