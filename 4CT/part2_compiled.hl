let f_EQ_bool_list =
  let EQ_LIST_case1, EQ_LIST_case2, EQ_LIST_case3, EQ_LIST_case4 =
    match List.map standardize
 (inst_type_thms `:(bool)list->(bool)list->bool` (local_split_thm EQ_LIST))
   with
    | [th1; th2; th3; th4] -> (th1, th2, th3, th4)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:bool`)) in
  let var_xs = standardize_tm (mk_var ("xs", `:(bool)list`)) in
  let var_y = standardize_tm (mk_var ("y", `:bool`)) in
  let var_ys = standardize_tm (mk_var ("ys", `:(bool)list`)) in
  let rec f_EQ_bool_list tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (xs, xs1) when compare xs xs1 = 0 ->
      trans_opt opt_th (INST [xs, var_xs] EQ_LIST_case1)
    | (Const ("NIL", _), Comb (Comb (Const ("CONS", _), x), xs)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case2)
    | (Comb (Comb (Const ("CONS", _), x), xs), Const ("NIL", _)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case3)
    | (Comb (Comb (Const ("CONS", _), x), xs), Comb (Comb
                                                (Const ("CONS", _), y), ys)) ->
      let base_th =
        trans_opt opt_th
          (INST [ys, var_ys; y, var_y; xs, var_xs; x, var_x] EQ_LIST_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = f_EQ_bool x y None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EQ_bool_list xs ys (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EQ_bool_list"
     in
  f_EQ_bool_list
;;

