let f_MEM_num =
  let MEM_case1, MEM_case2 =
    match List.map standardize
      (inst_type_thms `:num->(num)list->bool` (local_split_thm MEM)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:num`)) in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_t = standardize_tm (mk_var ("t", `:(num)list`)) in
  let rec f_MEM_num tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (x, Const ("NIL", _)) -> trans_opt opt_th (INST [x, var_x] MEM_case1)
    | (x, Comb (Comb (Const ("CONS", _), h), t)) ->
      let base_th =
        trans_opt opt_th (INST [x, var_x; t, var_t; h, var_h] MEM_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = conv_EQ_num x h None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_OR in
          TRANS (TRANS base_th th0) th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_OR in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_MEM_num x t (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_MEM_num"
     in
  f_MEM_num
;;

let f_ctrmask_rec =
  let CTRMASK_REC_NUM_case1 =
    match List.map standardize (local_split_thm CTRMASK_REC_NUM) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(bool)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let var_cci = standardize_tm (mk_var ("cci", `:(num)list`)) in
  let var_i = standardize_tm (mk_var ("i", `:num`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let COND_bool_list_T =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_T) in
  let COND_bool_list_F =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_F) in
  let rec f_ctrmask_rec cci i n opt_th =
    let base_th =
      trans_opt opt_th
        (INST [n, var_n; i, var_i; cci, var_cci] CTRMASK_REC_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a6),
            (Comb (Comb (a5, _), Comb (Comb (a4, _), Comb (_, a3))) as a7))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_MEM_num i cci None in
        let r3 = conv_ADD i a3 None in
        let r4 = conv_SUB n a3 None in
        let r5 =
          let r5 = MK_COMB (MK_COMB (REFL a4, r3), r4) in
          f_ctrmask_rec cci (rand (concl r3)) (rand (concl r4)) (Some r5) in
        TRANS base_th (MK_COMB (MK_COMB (REFL a5, r2), r5))
    | _ -> failwith "bad pattern"
     in
  f_ctrmask_rec
;;

let f_EQ_cpstep =
  let EQ_CPSTEP_case1, EQ_CPSTEP_case2, EQ_CPSTEP_case3, EQ_CPSTEP_case4,
 EQ_CPSTEP_case5, EQ_CPSTEP_case6, EQ_CPSTEP_case7, EQ_CPSTEP_case8,
 EQ_CPSTEP_case9, EQ_CPSTEP_case10, EQ_CPSTEP_case11, EQ_CPSTEP_case12,
 EQ_CPSTEP_case13, EQ_CPSTEP_case14, EQ_CPSTEP_case15, EQ_CPSTEP_case16,
 EQ_CPSTEP_case17, EQ_CPSTEP_case18, EQ_CPSTEP_case19, EQ_CPSTEP_case20,
 EQ_CPSTEP_case21, EQ_CPSTEP_case22, EQ_CPSTEP_case23, EQ_CPSTEP_case24,
 EQ_CPSTEP_case25, EQ_CPSTEP_case26, EQ_CPSTEP_case27, EQ_CPSTEP_case28,
 EQ_CPSTEP_case29, EQ_CPSTEP_case30, EQ_CPSTEP_case31, EQ_CPSTEP_case32,
 EQ_CPSTEP_case33, EQ_CPSTEP_case34, EQ_CPSTEP_case35, EQ_CPSTEP_case36,
 EQ_CPSTEP_case37, EQ_CPSTEP_case38, EQ_CPSTEP_case39, EQ_CPSTEP_case40,
   EQ_CPSTEP_case41, EQ_CPSTEP_case42, EQ_CPSTEP_case43, EQ_CPSTEP_case44 =
    match List.map standardize (local_split_thm EQ_CPSTEP) with
    | [th1; th2; th3; th4; th5; th6; th7; th8; th9; th10; th11; th12; th13;
 th14; th15; th16; th17; th18; th19; th20; th21; th22; th23; th24; th25; th26;
 th27; th28; th29; th30; th31; th32; th33; th34; th35; th36; th37; th38; th39;
 th40; th41; th42; th43; th44] ->
      (th1, th2, th3, th4, th5, th6, th7, th8, th9, th10, th11, th12, th13,
 th14, th15, th16, th17, th18, th19, th20, th21, th22, th23, th24, th25, th26,
 th27, th28, th29, th30, th31, th32, th33, th34, th35, th36, th37, th38, th39,
   th40, th41, th42, th43, th44)
    | _ -> failwith "error"
     in
  let var_a1 = standardize_tm (mk_var ("a", `:num`)) in
  let var_a = standardize_tm (mk_var ("a'", `:num`)) in
  let var_x = standardize_tm (mk_var ("x", `:cpstep`)) in
  let rec f_EQ_cpstep tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (x, x1) when compare x x1 = 0 ->
      trans_opt opt_th (INST [x, var_x] EQ_CPSTEP_case1)
    | (Comb (Const ("CpR", _), a1), Const ("CpRr", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case2)
    | (Const ("CpRr", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case3)
    | (Comb (Const ("CpR", _), a1), Const ("CpY", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case4)
    | (Const ("CpY", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case5)
    | (Comb (Const ("CpR", _), a1), Const ("CpH", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case6)
    | (Const ("CpH", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case7)
    | (Comb (Const ("CpR", _), a1), Const ("CpU", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case8)
    | (Const ("CpU", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case9)
    | (Comb (Const ("CpR", _), a1), Const ("CpK", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case10)
    | (Const ("CpK", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case11)
    | (Comb (Const ("CpR", _), a1), Const ("CpA", _)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case12)
    | (Const ("CpA", _), Comb (Const ("CpR", _), a1)) ->
      trans_opt opt_th (INST [a1, var_a1] EQ_CPSTEP_case13)
    | (Const ("CpRr", _), Const ("CpY", _)) ->
      trans_opt opt_th EQ_CPSTEP_case14
    | (Const ("CpY", _), Const ("CpRr", _)) ->
      trans_opt opt_th EQ_CPSTEP_case15
    | (Const ("CpRr", _), Const ("CpH", _)) ->
      trans_opt opt_th EQ_CPSTEP_case16
    | (Const ("CpH", _), Const ("CpRr", _)) ->
      trans_opt opt_th EQ_CPSTEP_case17
    | (Const ("CpRr", _), Const ("CpU", _)) ->
      trans_opt opt_th EQ_CPSTEP_case18
    | (Const ("CpU", _), Const ("CpRr", _)) ->
      trans_opt opt_th EQ_CPSTEP_case19
    | (Const ("CpRr", _), Const ("CpK", _)) ->
      trans_opt opt_th EQ_CPSTEP_case20
    | (Const ("CpK", _), Const ("CpRr", _)) ->
      trans_opt opt_th EQ_CPSTEP_case21
    | (Const ("CpRr", _), Const ("CpA", _)) ->
      trans_opt opt_th EQ_CPSTEP_case22
    | (Const ("CpA", _), Const ("CpRr", _)) ->
      trans_opt opt_th EQ_CPSTEP_case23
    | (Const ("CpY", _), Const ("CpH", _)) ->
      trans_opt opt_th EQ_CPSTEP_case24
    | (Const ("CpH", _), Const ("CpY", _)) ->
      trans_opt opt_th EQ_CPSTEP_case25
    | (Const ("CpY", _), Const ("CpU", _)) ->
      trans_opt opt_th EQ_CPSTEP_case26
    | (Const ("CpU", _), Const ("CpY", _)) ->
      trans_opt opt_th EQ_CPSTEP_case27
    | (Const ("CpY", _), Const ("CpK", _)) ->
      trans_opt opt_th EQ_CPSTEP_case28
    | (Const ("CpK", _), Const ("CpY", _)) ->
      trans_opt opt_th EQ_CPSTEP_case29
    | (Const ("CpY", _), Const ("CpA", _)) ->
      trans_opt opt_th EQ_CPSTEP_case30
    | (Const ("CpA", _), Const ("CpY", _)) ->
      trans_opt opt_th EQ_CPSTEP_case31
    | (Const ("CpH", _), Const ("CpU", _)) ->
      trans_opt opt_th EQ_CPSTEP_case32
    | (Const ("CpU", _), Const ("CpH", _)) ->
      trans_opt opt_th EQ_CPSTEP_case33
    | (Const ("CpH", _), Const ("CpK", _)) ->
      trans_opt opt_th EQ_CPSTEP_case34
    | (Const ("CpK", _), Const ("CpH", _)) ->
      trans_opt opt_th EQ_CPSTEP_case35
    | (Const ("CpH", _), Const ("CpA", _)) ->
      trans_opt opt_th EQ_CPSTEP_case36
    | (Const ("CpA", _), Const ("CpH", _)) ->
      trans_opt opt_th EQ_CPSTEP_case37
    | (Const ("CpU", _), Const ("CpK", _)) ->
      trans_opt opt_th EQ_CPSTEP_case38
    | (Const ("CpK", _), Const ("CpU", _)) ->
      trans_opt opt_th EQ_CPSTEP_case39
    | (Const ("CpU", _), Const ("CpA", _)) ->
      trans_opt opt_th EQ_CPSTEP_case40
    | (Const ("CpA", _), Const ("CpU", _)) ->
      trans_opt opt_th EQ_CPSTEP_case41
    | (Const ("CpK", _), Const ("CpA", _)) ->
      trans_opt opt_th EQ_CPSTEP_case42
    | (Const ("CpA", _), Const ("CpK", _)) ->
      trans_opt opt_th EQ_CPSTEP_case43
    | (Comb (Const ("CpR", _), a1), Comb (Const ("CpR", _), a)) ->
      let base_th =
        trans_opt opt_th (INST [a, var_a; a1, var_a1] EQ_CPSTEP_case44) in
      conv_EQ_num a1 a (Some base_th)
    | _ -> failwith "No match: f_EQ_cpstep"
     in
  f_EQ_cpstep
;;

let f_EQ_cpstep_list =
  let EQ_LIST_case1, EQ_LIST_case2, EQ_LIST_case3, EQ_LIST_case4 =
    match List.map standardize
 (inst_type_thms `:(cpstep)list->(cpstep)list->bool` (local_split_thm EQ_LIST))
   with
    | [th1; th2; th3; th4] -> (th1, th2, th3, th4)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:cpstep`)) in
  let var_xs = standardize_tm (mk_var ("xs", `:(cpstep)list`)) in
  let var_y = standardize_tm (mk_var ("y", `:cpstep`)) in
  let var_ys = standardize_tm (mk_var ("ys", `:(cpstep)list`)) in
  let rec f_EQ_cpstep_list tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (xs, xs1) when compare xs xs1 = 0 ->
      trans_opt opt_th (INST [xs, var_xs] EQ_LIST_case1)
    | (Const ("NIL", _), Comb (Comb (Const ("CONS", _), x), xs)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case2)
    | (Comb (Comb (Const ("CONS", _), x), xs), Const ("NIL", _)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case3)
    | (Comb (Comb (Const ("CONS", _), x), xs), Comb (Comb
                                                (Const ("CONS", _), y), ys)) ->
      let base_th =
        trans_opt opt_th
          (INST [ys, var_ys; y, var_y; xs, var_xs; x, var_x] EQ_LIST_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = f_EQ_cpstep x y None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EQ_cpstep_list xs ys (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EQ_cpstep_list"
     in
  f_EQ_cpstep_list
;;

let f_ctrmsize =
  let CTRMSIZE_CASES_case1, CTRMSIZE_CASES_case2, CTRMSIZE_CASES_case3,
 CTRMSIZE_CASES_case4, CTRMSIZE_CASES_case5, CTRMSIZE_CASES_case6,
   CTRMSIZE_CASES_case7, CTRMSIZE_CASES_case8 =
    match List.map standardize (local_split_thm CTRMSIZE_CASES) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:num`)) in
  let var_t = standardize_tm (mk_var ("t", `:num`)) in
  let var_cp = standardize_tm (mk_var ("cp'", `:(cpstep)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let COND_num_T = standardize (INST_TYPE [`:num`, aty] COND_T) in
  let COND_num_F = standardize (INST_TYPE [`:num`, aty] COND_F) in
  let rec f_ctrmsize tm1 opt_th =
    match tm1 with
    | Const ("NIL", _) -> trans_opt opt_th CTRMSIZE_CASES_case1
    | Comb (Comb (Const ("CONS", _), Comb (Const ("CpR", _), n)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp; n, var_n] CTRMSIZE_CASES_case2) in
      f_ctrmsize cp (Some base_th)
    | Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp) ->
      trans_opt opt_th (INST [cp, var_cp] CTRMSIZE_CASES_case3)
    | Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CTRMSIZE_CASES_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a4),
                       (Comb (a3, _) as a5))) ->
        let r1 = f_EQ_cpstep_list cp a1 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a4), REFL a5) in
          let th1 = INST [(a4, var_t); (a5, var_e)] COND_num_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a4), REFL a5) in
          let th1 = INST [(a4, var_t); (a5, var_e)] COND_num_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_ctrmsize cp None in
          let r3 = MK_COMB (REFL a3, r2) in
          conv_SUC (rand (concl r2)) (Some (TRANS base_th r3))
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp) ->
      let base_th =
