        else
          let a2_eq =
            if is_true_th (REFL b1) then
              let th0 = MK_COMB (MK_COMB (REFL a10, REFL b1), REFL a5) in
              let th1 = INST[a5, p_var_bool] T_OR in
              TRANS th0 th1
            else
              let a2_eq =
                let r2 = f_TL_bool mr1 None in
                let r3 =
                  let r3 = MK_COMB (REFL a1', r2) in
                  f_TL_bool (rand (concl r2)) (Some r3) in
                let r4 =
                  let r4 = MK_COMB (MK_COMB (REFL a2', r3), REFL a3) in
                  f_APPEND_bool (rand (concl r3)) a3 (Some r4) in
                let r5 = MK_COMB (REFL a4, r4) in
                f_HD_bool (rand (concl r4)) (Some r5) in
              let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
              TRANS (MK_COMB (MK_COMB (REFL a10, REFL b1), a2_eq)) or_th in
          let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
          TRANS (MK_COMB (MK_COMB (REFL a10, REFL b0), a2_eq)) or_th in
      let r3 = f_EQ_bool_list mr a8 None in
      let r4 =
