                  INST [(et, var_t1); (a10, var_e1)] COND_color_list_F in
                TRANS th0 th1 in
            let r10 = MK_COMB (REFL a11, r9) in
            f_cpcol cp (rand (concl r9)) (Some (TRANS base_th r10))
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, r6), REFL a12), REFL a13) in
            let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_F in
            TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_cpcol"
     in
  f_cpcol
;;

let f_cpcolor0 =
  let CPCOLOR0_CPCOL_case1, CPCOLOR0_CPCOL_case2, CPCOLOR0_CPCOL_case3,
 CPCOLOR0_CPCOL_case4, CPCOLOR0_CPCOL_case5, CPCOLOR0_CPCOL_case6,
   CPCOLOR0_CPCOL_case7, CPCOLOR0_CPCOL_case8 =
    match List.map standardize (local_split_thm CPCOLOR0_CPCOL) with
    | [th1; th2; th3; th4; th5; th6; th7; th8] ->
      (th1, th2, th3, th4, th5, th6, th7, th8)
    | _ -> failwith "error"
     in
  let var_cp = standardize_tm (mk_var ("cp'", `:(cpstep)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let rec f_cpcolor0 tm1 opt_th =
    match tm1 with
    | Const ("NIL", _) ->
      let base_th = trans_opt opt_th CPCOLOR0_CPCOL_case1 in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a1), a2)) -> f_cpcol a1 a2 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Comb (Const ("CpR", _), n)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp; n, var_n] CPCOLOR0_CPCOL_case2) in
      f_cpcolor0 cp (Some base_th)
    | Comb (Comb (Const ("CONS", _), Const ("CpRr", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case3) in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a1), a2)) -> f_cpcol a1 a2 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpY", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case4) in
      (match concl base_th with
      | Comb (_, Comb (_, a1)) -> f_cpcol cp a1 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case5) in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a1), a2)) -> f_cpcol a1 a2 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpU", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case6) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a3, Comb (_, a1)), Comb (_, a2))) ->
        let r1 = f_cpcol cp a1 None in
        let r2 = f_cpcol cp a2 None in
        let r3 = MK_COMB (MK_COMB (REFL a3, r1), r2) in
        f_ctree_union (rand (concl r1)) (rand (concl r2))
          (Some (TRANS base_th r3))
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpK", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case7) in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a1), a2)) -> f_cpcol a1 a2 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | Comb (Comb (Const ("CONS", _), Const ("CpA", _)), cp) ->
      let base_th =
        trans_opt opt_th (INST [cp, var_cp] CPCOLOR0_CPCOL_case8) in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a1), a2)) -> f_cpcol a1 a2 (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_cpcolor0"
     in
  f_cpcolor0
;;

let f_ctree_cons_rot =
  let ctree_cons_rot_case1 =
    match List.map standardize (local_split_thm ctree_cons_rot) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let rec f_ctree_cons_rot t opt_th =
    let base_th = trans_opt opt_th (INST [t, var_t] ctree_cons_rot_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a1, _), _)) ->
      let r1 = f_ctree_rotl t None in
      let r2 = f_ctree_rotr t None in
      let r3 = MK_COMB (MK_COMB (REFL a1, r1), r2) in
      f_ctree_cons t (rand (concl r1)) (rand (concl r2))
        (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"
     in
  f_ctree_cons_rot
;;

let f_cpcolor =
  let cpcolor_case1 =
    match List.map standardize (local_split_thm cpcolor) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let rec f_cpcolor cp opt_th =
    let base_th = trans_opt opt_th (INST [cp, var_cp] cpcolor_case1) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (a1, _))) ->
      let r1 = f_REVERSE_cpstep cp None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_cpcolor0 (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      f_ctree_cons_rot (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"
     in
  f_cpcolor
;;

let f_FILTER_cpstep =
  let FILTER_case1, FILTER_case2 =
    match List.map standardize
 (inst_type_thms `:(cpstep->bool)->(cpstep)list->(cpstep)list`
 (local_split_thm FILTER)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(cpstep)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(cpstep)list`)) in
  let var_id_P = standardize_tm (mk_var ("P", `:cpstep->bool`)) in
  let var_h = standardize_tm (mk_var ("h", `:cpstep`)) in
  let COND_cpstep_list_T =
    standardize (INST_TYPE [`:(cpstep)list`, aty] COND_T) in
  let COND_cpstep_list_F =
    standardize (INST_TYPE [`:(cpstep)list`, aty] COND_F) in
  let rec f_FILTER_cpstep tm1 tm2 opt_th =
    match (tm1, tm2) with
    | ((id_P, func_id_P), Const ("NIL", _)) ->
      trans_opt opt_th (INST [id_P, var_id_P] FILTER_case1)
    | ((id_P, func_id_P), Comb (Comb (Const ("CONS", _), h), t)) ->
      let base_th =
        trans_opt opt_th
          (INST [id_P, var_id_P; t, var_t; h, var_h] FILTER_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), (Comb (a2, _) as a3)), a4)) ->
        let r1 = func_id_P h None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_cpstep_list_T in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_FILTER_cpstep (id_P, func_id_P) t None in
          TRANS base_th (MK_COMB (REFL a2, r2))
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a3), REFL a4) in
          let th1 = INST [(a3, var_t); (a4, var_e)] COND_cpstep_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_FILTER_cpstep (id_P, func_id_P) t (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_FILTER_cpstep"
     in
  f_FILTER_cpstep
;;

let f_LENGTH_cpstep =
  let LENGTH_case1, LENGTH_case2 =
    match List.map standardize
      (inst_type_thms `:(cpstep)list->num` (local_split_thm LENGTH)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:cpstep`)) in
  let var_t = standardize_tm (mk_var ("t", `:(cpstep)list`)) in
  let rec f_LENGTH_cpstep tm1 opt_th =
    match tm1 with
    | Const ("NIL", _) -> trans_opt opt_th LENGTH_case1
    | Comb (Comb (Const ("CONS", _), h), t) ->
      let base_th =
        trans_opt opt_th (INST [t, var_t; h, var_h] LENGTH_case2) in
      (match concl base_th with
      | Comb (_, Comb (a1, _)) ->
        let r1 = f_LENGTH_cpstep t None in
        let r2 = MK_COMB (REFL a1, r1) in
        conv_SUC (rand (concl r1)) (Some (TRANS base_th r2))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_LENGTH_cpstep"
     in
  f_LENGTH_cpstep
;;

let f_cpksize =
  let cpksize_case1 =
    match List.map standardize (local_split_thm cpksize) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let var_s = standardize_tm (mk_var ("s", `:cpstep`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrlr" (concl cpksize_case1),
   List.map (C follow_full_path (concl cpksize_case1)) ["rrlrblr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let rec abs_1 s opt_th =
    let base_th = trans_opt opt_th (INST [s, var_s] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb (_, a1)) -> f_EQ_cpstep s a1 (Some base_th)
    | _ -> failwith "bad pattern"

  and f_cpksize cp opt_th =
    let base_th = trans_opt opt_th (INST [cp, var_cp] cpksize_case1) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = (a1, abs_1) in
      let r2 = f_FILTER_cpstep r1 cp None in
      let r3 = MK_COMB (REFL a2, r2) in
      f_LENGTH_cpstep (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

   in
  f_cpksize
;;

let f_EX_bool =
  let EX_case1, EX_case2 =
    match List.map standardize
   (inst_type_thms `:(bool->bool)->(bool)list->bool` (local_split_thm EX)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_id_P = standardize_tm (mk_var ("P", `:bool->bool`)) in
  let var_h = standardize_tm (mk_var ("h", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let rec f_EX_bool tm1 tm2 opt_th =
    match (tm1, tm2) with
    | ((id_P, func_id_P), Const ("NIL", _)) ->
      trans_opt opt_th (INST [id_P, var_id_P] EX_case1)
    | ((id_P, func_id_P), Comb (Comb (Const ("CONS", _), h), t)) ->
      let base_th =
        trans_opt opt_th
          (INST [id_P, var_id_P; t, var_t; h, var_h] EX_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = func_id_P h None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_OR in
          TRANS (TRANS base_th th0) th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_OR in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EX_bool (id_P, func_id_P) t (Some base_th)
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EX_bool"
     in
  f_EX_bool
;;

