  let var_t = standardize_tm (mk_var ("t", `:ctree#gtree_pair`)) in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_d = standardize_tm (mk_var ("d", `:num`)) in
  let var_ctu = standardize_tm (mk_var ("ctu", `:ctree`)) in
  let var_ctr = standardize_tm (mk_var ("ctr", `:ctree`)) in
  let var_gtu = standardize_tm (mk_var ("gtu", `:gtree`)) in
  let COND_ctree_gtree_pair_T =
    standardize (INST_TYPE [`:ctree#gtree_pair`, aty] COND_T) in
  let COND_ctree_gtree_pair_F =
    standardize (INST_TYPE [`:ctree#gtree_pair`, aty] COND_F) in
  let rec f_kempe_tree_closure_fn h d ctu ctr gtu opt_th =
    let base_th =
      trans_opt opt_th
 (INST [h, var_h; d, var_d; gtu, var_gtu; ctr, var_ctr; ctu, var_ctu]
   kempe_tree_closure_fn_eN_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), (Comb (a4, Comb (_, a3)) as
 a9)), (Comb ((Comb (_, (Comb (a7, Comb (_, a5)) as a6)) as a8), _) as a10)))
   ->
      let r1 = conv_EQ_num d a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a9), REFL a10) in
        let th1 = INST [(a9, var_t); (a10, var_e)] COND_ctree_gtree_pair_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_gtree_restrict gtu a3 None in
        TRANS base_th (MK_COMB (REFL a4, r2))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a9), REFL a10) in
        let th1 = INST [(a9, var_t); (a10, var_e)] COND_ctree_gtree_pair_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB d a5 None in
        let r3 =
          (a6, fun tm1 tm2 tm3 opt_th ->
                 let r3 =
                   MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a7, r2), REFL tm1),
                                     REFL tm2), REFL tm3) in
                 f_kempe_tree_closure_fn h (rand (concl r2)) tm1 tm2 tm3
                   (Some (trans_opt opt_th r3))) in
        let r4 =
          let r4 =
            MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a7, r2), REFL ctu), REFL
                              ctr), REFL gtu) in
          f_kempe_tree_closure_fn h (rand (concl r2)) ctu ctr gtu (Some r4) in
        let r5 =
          let r5 = MK_COMB (REFL a8, r4) in
          f_ktc_stepp h r3 (rand (concl r4)) (Some r5) in
        let r6 = MK_COMB (REFL a8, r5) in
        f_ktc_stepp h r3 (rand (concl r5)) (Some (TRANS base_th r6))
    | _ -> failwith "bad pattern"
     in
  f_kempe_tree_closure_fn
;;

let f_kempe_tree_closure =
  let kempe_tree_closure_case1 =
    match List.map standardize (local_split_thm kempe_tree_closure) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_d = standardize_tm (mk_var ("d", `:num`)) in
  let var_ctu = standardize_tm (mk_var ("ctu", `:ctree`)) in
  let var_ctr = standardize_tm (mk_var ("ctr", `:ctree`)) in
  let var_gtu = standardize_tm (mk_var ("gtu", `:gtree`)) in
  let rec f_kempe_tree_closure h d ctu ctr gtu opt_th =
    let base_th =
      trans_opt opt_th
 (INST [gtu, var_gtu; ctr, var_ctr; ctu, var_ctu; d, var_d; h, var_h]
   kempe_tree_closure_case1) in
    f_kempe_tree_closure_fn h d ctu ctr gtu (Some base_th) in
  f_kempe_tree_closure
;;

let f_kempe_tree_h =
  let kempe_tree_h_case1 =
    match List.map standardize (local_split_thm kempe_tree_h) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let rec f_kempe_tree_h h cp opt_th =
    let base_th =
      trans_opt opt_th (INST [h, var_h; cp, var_cp] kempe_tree_h_case1) in
    match concl base_th with
    | Comb (_, Comb (a5, Comb (Comb (Comb (Comb (a4, _), Comb (a2, _)), _),
                               Comb (a3, Comb (a1, _))))) ->
      let r1 = conv_SUC h None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        conv_SUC (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a2, r1) in
        f_ctree_init_tree (rand (concl r1)) (Some r3) in
      let r4 = f_cpcolor cp None in
      let r5 =
        let r5 = MK_COMB (REFL a3, r1) in
        f_gtree_init_tree (rand (concl r1)) (Some r5) in
      let r6 =
        let r6 =
          MK_COMB (MK_COMB (MK_COMB (MK_COMB (REFL a4, r2), r3), r4), r5) in
        f_kempe_tree_closure h (rand (concl r2)) (rand (concl r3))
          (rand (concl r4)) (rand (concl r5)) (Some r6) in
      let r7 = MK_COMB (REFL a5, r6) in
      f_FST_gtree_pair_ctree (rand (concl r6)) (Some (TRANS base_th r7))
    | _ -> failwith "bad pattern"
     in
  f_kempe_tree_h
;;

let f_kempe_tree =
  let KEMPE_TREE_FO_case1 =
    match List.map standardize (local_split_thm KEMPE_TREE_FO) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_cp = standardize_tm (mk_var ("cp", `:(cpstep)list`)) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec f_kempe_tree cp opt_th =
    let base_th = trans_opt opt_th (INST [cp, var_cp] KEMPE_TREE_FO_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (a1, _)), (Comb
                       (Comb (a5, Comb (Comb (a3, _), a4)), _) as a6)), a7)) ->
      let r1 = conv_cprsize cp None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        conv_LE a4 (rand (concl r1)) (Some r2) in
      if is_true_th r2 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_ctree_T in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 =
          let r3 = MK_COMB (MK_COMB (REFL a3, r1), REFL a4) in
          conv_SUB (rand (concl r1)) a4 (Some r3) in
        let r4 = MK_COMB (MK_COMB (REFL a5, r3), REFL cp) in
        f_kempe_tree_h (rand (concl r3)) cp (Some (TRANS base_th r4))
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_ctree_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
  f_kempe_tree
;;

let f_check_reducible =
  let CHECK_REDUCIBLE_OPT_case1 =
    match List.map standardize (local_split_thm CHECK_REDUCIBLE_OPT) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_cf = standardize_tm (mk_var ("cf", `:(cpstep)list#(num)list`)) in
  let rec f_check_reducible cf opt_th =
    let base_th =
      trans_opt opt_th (INST [cf, var_cf] CHECK_REDUCIBLE_OPT_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a2, Comb (a1, _)), _)) ->
      let r1 = f_cfprog cf None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_kempe_tree (rand (concl r1)) (Some r2) in
      let r3 = f_contract_ctree cf None in
      let r4 = MK_COMB (MK_COMB (REFL a2, r2), r3) in
      f_check_red_opt (rand (concl r2)) (rand (concl r3))
        (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"
     in
  f_check_reducible
;;
