 permc_DEF_case5, permc_DEF_case6, permc_DEF_case7, permc_DEF_case8,
 permc_DEF_case9, permc_DEF_case10, permc_DEF_case11, permc_DEF_case12,
 permc_DEF_case13, permc_DEF_case14, permc_DEF_case15, permc_DEF_case16,
 permc_DEF_case17, permc_DEF_case18, permc_DEF_case19, permc_DEF_case20,
