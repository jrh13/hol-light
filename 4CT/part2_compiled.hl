  and f_gtree_restrict_q tm1 tm2 tm3 tm4 tm5 opt_th =
    match (tm1, tm2, tm3, tm4, tm5) with
    | (t0, t1, t2, t3, Comb (Comb (Const (",", _), r0), Comb
