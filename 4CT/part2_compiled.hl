let f_ctree_leaf_pair_q =
  let CTREE_LEAF_PAIR_Q_P_case1 =
    match List.map standardize (local_split_thm CTREE_LEAF_PAIR_Q_P) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_lf1 = standardize_tm (mk_var ("lf1", `:ctree`)) in
  let var_lf2 = standardize_tm (mk_var ("lf2", `:ctree`)) in
  let var_lf3 = standardize_tm (mk_var ("lf3", `:ctree`)) in
  let var_a = standardize_tm (mk_var ("a", `:ctree`)) in
  let var_b = standardize_tm (mk_var ("b", `:ctree`)) in
  let var_c = standardize_tm (mk_var ("c", `:ctree`)) in
  let rec f_ctree_leaf_pair_q tm1 tm2 tm3 tm4 opt_th =
    match (tm1, tm2, tm3, tm4) with
    | (lf1, lf2, lf3, Comb (Comb (Const (",", _), a), Comb
                            (Comb (Const (",", _), b), c))) ->
      let base_th =
        trans_opt opt_th
 (INST [c, var_c; b, var_b; a, var_a; lf3, var_lf3; lf2, var_lf2; lf1, var_lf1]
   CTREE_LEAF_PAIR_Q_P_case1) in
      f_ctree_leaf_pair lf1 lf2 lf3 a b c (Some base_th)
    | _ -> failwith "No match: f_ctree_leaf_pair_q"
     in
  f_ctree_leaf_pair_q
;;

let f_ctree_add_dyck_iter, f_ctree_add_dyck_fn =
  let CTREE_ADD_DYCK_FN_ITER_NUM_case1 =
    match List.map standardize
      (local_split_thm CTREE_ADD_DYCK_FN_ITER_NUM) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let CTREE_ADD_DYCK_ITER_NUM_case1 =
    match List.map standardize (local_split_thm CTREE_ADD_DYCK_ITER_NUM) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_n = standardize_tm (mk_var ("n'", `:num`)) in
  let var_m = standardize_tm (mk_var ("m", `:num`)) in
  let var_lf = standardize_tm (mk_var ("lf", `:ctree`)) in
  let var_k = standardize_tm (mk_var ("k", `:num`)) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec f_ctree_add_dyck_iter n k lf opt_th =
    let base_th =
      trans_opt opt_th
       (INST [k, var_k; lf, var_lf; n, var_n] CTREE_ADD_DYCK_ITER_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), _),
 (Comb (Comb (a6, Comb (a4, _)), Comb (Comb (a5, Comb (_, a3)), _)) as a7))) ->
      let r1 = conv_EQ_num k a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL lf), REFL a7) in
        let th1 = INST [(lf, var_t); (a7, var_e)] COND_ctree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL lf), REFL a7) in
        let th1 = INST [(lf, var_t); (a7, var_e)] COND_ctree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB k a3 None in
        let r3 =
          let r3 = MK_COMB (REFL a4, r2) in
          conv_SUC (rand (concl r2)) (Some r3) in
        let r4 =
          let r4 = MK_COMB (MK_COMB (REFL a5, r2), REFL lf) in
          f_ctree_add_dyck_iter n (rand (concl r2)) lf (Some r4) in
        let r5 = MK_COMB (MK_COMB (REFL a6, r3), r4) in
        f_ctree_add_dyck_fn n (rand (concl r3)) (rand (concl r4))
          (Some (TRANS base_th r5))
    | _ -> failwith "bad pattern"

  and f_ctree_add_dyck_fn n m lf opt_th =
    let base_th =
      trans_opt opt_th
    (INST [lf, var_lf; n, var_n; m, var_m] CTREE_ADD_DYCK_FN_ITER_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a5),
                     (Comb (Comb (Comb (a4, Comb (_, a3)), _), _) as a6))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a5), REFL a6) in
        let th1 = INST [(a5, var_t); (a6, var_e)] COND_ctree_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a5), REFL a6) in
        let th1 = INST [(a5, var_t); (a6, var_e)] COND_ctree_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB n a3 None in
        let r3 = conv_SUC m None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a4, r2), r3), REFL lf) in
        f_ctree_add_dyck_iter (rand (concl r2)) (rand (concl r3)) lf
          (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"

   in
  (f_ctree_add_dyck_iter, f_ctree_add_dyck_fn)
;;

let f_SND_cpstep_list_num_list =
  let SND_case1 =
    match List.map standardize
 (inst_type_thms `:(cpstep)list#(num)list->(num)list` (local_split_thm SND))
   with
    | [th1] -> th1
    | _ -> failwith "error"
     in
