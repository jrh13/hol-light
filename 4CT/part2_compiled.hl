    let base_th =
      trans_opt opt_th (INST [cp, var_cp; i, var_i] cfmask1_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a4, Comb (Comb (a1, _), a2)), Comb (a3, _))) ->
      let r1 = conv_cprsize cp None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
        f_REPLICATE_bool (rand (concl r1)) a2 (Some r2) in
      let r3 = f_cpksize cp None in
      let r4 =
        let r4 = MK_COMB (REFL a3, r3) in
        f_mask_pred1 i (rand (concl r3)) (Some r4) in
      TRANS base_th (MK_COMB (MK_COMB (REFL a4, r2), r4))
    | _ -> failwith "bad pattern"
     in
  f_cfmask1
