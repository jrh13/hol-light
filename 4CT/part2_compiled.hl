 (_,
 (Comb (Comb (a10, _), (Comb (a4, Comb (Comb (a2', Comb (a1', _)), a3)) as a5))
   as a6))), Comb (Comb (Comb (a7, _), a8), a9)))), _)) ->
      let r1 =
        if is_true_th (REFL a0) then
          let th0 = MK_COMB (MK_COMB (REFL a10, REFL a0), REFL b11) in
          let th1 = INST[b11, p_var_bool] T_OR in
          TRANS th0 th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a10, REFL a0), REFL b11) in
          let th1 = INST[b11, p_var_bool] F_OR in
          TRANS th0 th1 in
      let r2 =
        if is_true_th (REFL b0) then
          let th0 = MK_COMB (MK_COMB (REFL a10, REFL b0), REFL a6) in
          let th1 = INST[a6, p_var_bool] T_OR in
