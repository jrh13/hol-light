   Comb (Comb (Const ("GtreePair", _), t_31), t_3)) ->
      let base_th =
        trans_opt opt_th
 (INST [t_0, var_t_0; t_01, var_t_01; t_3, var_t_3; t_31, var_t_31;
 t_2, var_t_2; t_21, var_t_21; t_1, var_t_1; t_11, var_t_11; t, var_t]
   gtree_cons_pairs_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a3, _), a6), (Comb
                    (Comb (_, a4), (Comb (Comb (_, a1), a2) as a5)) as a7))) ->
        let r1 = f_gtree_empty4 a1 None in
