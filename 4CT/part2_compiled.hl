  let var_y = standardize_tm (mk_var ("y", `:(num)list`)) in
  let rec f_SND_cpstep_list_num_list tm1 opt_th =
    match tm1 with
    | Comb (Comb (Const (",", _), x), y) ->
      trans_opt opt_th (INST [y, var_y; x, var_x] SND_case1)
    | _ -> failwith "No match: f_SND_cpstep_list_num_list"
     in
  f_SND_cpstep_list_num_list
;;

