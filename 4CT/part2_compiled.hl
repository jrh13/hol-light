      let base_th =
        trans_opt opt_th
 (INST [cr, var_cr; br, var_br; ar, var_ar; cl, var_cl; bl, var_bl; al, var_al]
   CTREE_UNION_ROTLR_FO_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        let r1 = f_ctree_union_rotlr cl br None in
        let r2 = f_ctree_union_rotlr al cr None in
        let r3 = f_ctree_union_rotlr bl ar None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), r2), r3) in
        f_ctree_cons (rand (concl r1)) (rand (concl r2)) (rand (concl r3))
          (Some (TRANS base_th r4))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Comb (Const ("CtreeNode", _), al), bl), cl), Comb
       (Const ("CtreeLeaf", _), lr)) ->
      let base_th =
        trans_opt opt_th
 (INST [lr, var_lr; cl, var_cl; bl, var_bl; al, var_al]
   CTREE_UNION_ROTLR_FO_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a2, Comb (Comb (Comb (a1, _), _), _)), a3)) ->
        let r1 = f_ctree_rotl cl None in
        let r2 = f_ctree_rotl al None in
        let r3 = f_ctree_rotl bl None in
        let r4 =
          let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), r2), r3) in
          f_ctree_cons (rand (concl r1)) (rand (concl r2)) (rand (concl r3))
            (Some r4) in
        let r5 = MK_COMB (MK_COMB (REFL a2, r4), REFL a3) in
        f_ctree_union (rand (concl r4)) a3 (Some (TRANS base_th r5))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Comb (Const ("CtreeNode", _), al), bl), cl), Const
       ("CtreeEmpty", _)) ->
      let base_th =
        trans_opt opt_th
      (INST [cl, var_cl; bl, var_bl; al, var_al] CTREE_UNION_ROTLR_FO_case3) in
