  let var_p2 = standardize_tm (mk_var ("p2", `:gtree_pair`)) in
  let rec f_gl1 tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (Const ("T", _), p1, p2) ->
      trans_opt opt_th (INST [p1, var_p1; p2, var_p2] GL1_FO_case1)
    | (Const ("F", _), p1, p2) ->
      trans_opt opt_th (INST [p2, var_p2; p1, var_p1] GL1_FO_case2)
    | _ -> failwith "No match: f_gl1"
     in
  f_gl1
;;

let f_gl2 =
  let GL2_FO_case1, GL2_FO_case2, GL2_FO_case3, GL2_FO_case4 =
    match List.map standardize (local_split_thm GL2_FO) with
    | [th1; th2; th3; th4] -> (th1, th2, th3, th4)
    | _ -> failwith "error"
     in
  let var_p1 = standardize_tm (mk_var ("p1", `:gtree_pair`)) in
  let var_p2 = standardize_tm (mk_var ("p2", `:gtree_pair`)) in
  let var_p3 = standardize_tm (mk_var ("p3", `:gtree_pair`)) in
  let var_p4 = standardize_tm (mk_var ("p4", `:gtree_pair`)) in
  let rec f_gl2 tm1 tm2 tm3 tm4 tm5 tm6 opt_th =
    match (tm1, tm2, tm3, tm4, tm5, tm6) with
    | (Const ("T", _), Const ("T", _), p1, p2, p3, p4) ->
      trans_opt opt_th
        (INST [p1, var_p1; p4, var_p4; p3, var_p3; p2, var_p2] GL2_FO_case1)
