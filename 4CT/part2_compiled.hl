let f_mask_list_bool =
  let mask_list_case1, mask_list_case2 =
    match List.map standardize
 (inst_type_thms `:(bool)list->(bool)list->(bool)list`
 (local_split_thm mask_list)) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(bool)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let var_m = standardize_tm (mk_var ("m", `:(bool)list`)) in
  let var_s = standardize_tm (mk_var ("s", `:(bool)list`)) in
  let COND_bool_list_T =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_T) in
  let COND_bool_list_F =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_F) in
  let rec f_mask_list_bool tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (Const ("NIL", _), s) ->
      trans_opt opt_th (INST [s, var_s] mask_list_case1)
    | (Comb (Comb (Const ("CONS", _), b), m), s) ->
      let base_th =
        trans_opt opt_th
          (INST [s, var_s; m, var_m; b, var_b] mask_list_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (_, a6), (Comb (Comb (Comb (a1, _),
                    (Comb (Comb (a2, _), a5) as a4)), Comb (a3, _)) as a7))) ->
        let r1 = f_EQ_bool_list s a6 None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          if is_true_th (REFL b) then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL a4), REFL a5)
                in
            let th1 = INST [(a4, var_t); (a5, var_e)] COND_bool_list_T in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r2 = f_HD_bool s None in
            let r3 = f_TL_bool s None in
            let r4 =
              let r4 = MK_COMB (REFL a3, r3) in
              f_mask_list_bool m (rand (concl r3)) (Some r4) in
            TRANS base_th (MK_COMB (MK_COMB (REFL a2, r2), r4))
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a1, REFL b), REFL a4), REFL a5)
                in
            let th1 = INST [(a4, var_t); (a5, var_e)] COND_bool_list_F in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r2 = f_TL_bool s None in
            let r3 = MK_COMB (REFL a3, r2) in
            f_mask_list_bool m (rand (concl r2)) (Some (TRANS base_th r3))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_mask_list_bool"
     in
  f_mask_list_bool
;;

