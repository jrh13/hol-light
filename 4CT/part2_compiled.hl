      trans_opt opt_th (INST [l, var_l; n, var_n] TAKE_LIST_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a7),
 (Comb (_, (Comb (Comb (a5, _), Comb (Comb (a4, Comb (_, a3)), _)) as a6)) as
   a8))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a7), REFL a8) in
        let th1 = INST [(a7, var_t); (a8, var_e)] COND_color_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a7), REFL a8) in
        let th1 = INST [(a7, var_t); (a8, var_e)] COND_color_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_EQ_color_list l a7 None in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a7), REFL a6) in
          let th1 = INST [(a7, var_t); (a6, var_e)] COND_color_list_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a2, r2), REFL a7), REFL a6) in
          let th1 = INST [(a7, var_t); (a6, var_e)] COND_color_list_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = f_HD_color l None in
          let r4 = conv_SUB n a3 None in
          let r5 = f_TL_color l None in
          let r6 =
            let r6 = MK_COMB (MK_COMB (REFL a4, r4), r5) in
            f_take_list_color (rand (concl r4)) (rand (concl r5)) (Some r6) in
          TRANS base_th (MK_COMB (MK_COMB (REFL a5, r3), r6))
    | _ -> failwith "bad pattern"
     in
  f_take_list_color
;;

let f_rot_list_color =
  let rot_list_case1 =
    match List.map standardize
 (inst_type_thms `:num->(color)list->(color)list` (local_split_thm rot_list))
   with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_l = standardize_tm (mk_var ("l", `:(color)list`)) in
  let rec f_rot_list_color n l opt_th =
    let base_th =
      trans_opt opt_th (INST [l, var_l; n, var_n] rot_list_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a1, _), _)) ->
      let r1 = f_drop_list_color n l None in
      let r2 = f_take_list_color n l None in
      let r3 = MK_COMB (MK_COMB (REFL a1, r1), r2) in
      f_APPEND_color (rand (concl r1)) (rand (concl r2))
        (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"
     in
  f_rot_list_color
;;

let f_rotr_list_color =
  let rotr_list_case1 =
    match List.map standardize
 (inst_type_thms `:num->(color)list->(color)list` (local_split_thm rotr_list))
   with
    | [th1] -> th1
    | _ -> failwith "error"
     in
