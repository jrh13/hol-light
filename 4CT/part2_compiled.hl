          let r5 =
            let r5 = MK_COMB (REFL a3, r4) in
            f_HD_color (rand (concl r4)) (Some r5) in
          let r6 =
            let r6 = MK_COMB (MK_COMB (REFL a4, r3), r5) in
            f_EQ_color (rand (concl r3)) (rand (concl r5)) (Some r6) in
          if is_true_th r6 then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a5, r6), REFL a12), REFL a13) in
            let th1 = INST [(a12, var_t); (a13, var_e)] COND_ctree_T in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r7 =
              let r7 = MK_COMB (REFL a6, r4) in
              f_TL_color (rand (concl r4)) (Some r7) in
            let r8 =
              let r8 = MK_COMB (MK_COMB (REFL a7, r7), REFL a8) in
              f_EQ_color_list (rand (concl r7)) a8 (Some r8) in
            let r9 =
              if is_true_th r8 then
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a9, r8), REFL et), REFL a10)
                    in
                let th1 =
                  INST [(et, var_t1); (a10, var_e1)] COND_color_list_T in
                TRANS th0 th1
              else
                let th0 =
                  MK_COMB (MK_COMB (MK_COMB (REFL a9, r8), REFL et), REFL a10)
                    in
