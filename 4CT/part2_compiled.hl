          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a3, r1), REFL a6), REFL a7) in
          let th1 = INST [(a6, var_t1); (a7, var_e)] COND_gtree_pair_T in
          TRANS (TRANS base_th th0) th1
        else
