let f_gtree_empty =
  let gtree_empty_case1, gtree_empty_case2, gtree_empty_case3,
 gtree_empty_case4, gtree_empty_case5, gtree_empty_case6, gtree_empty_case7,
   gtree_empty_case8, gtree_empty_case9, gtree_empty_case10 =
    match List.map standardize (local_split_thm gtree_empty) with
    | [th1; th2; th3; th4; th5; th6; th7; th8; th9; th10] ->
      (th1, th2, th3, th4, th5, th6, th7, th8, th9, th10)
    | _ -> failwith "error"
     in
  let var_t0 = standardize_tm (mk_var ("t0", `:gtree`)) in
  let var_t1 = standardize_tm (mk_var ("t1", `:gtree`)) in
  let var_t2 = standardize_tm (mk_var ("t2", `:gtree`)) in
  let var_t3 = standardize_tm (mk_var ("t3", `:gtree`)) in
  let rec f_gtree_empty tm1 opt_th =
    match tm1 with
    | Const ("GtreeEmpty", _) -> trans_opt opt_th gtree_empty_case1
    | Comb (Comb (Comb (Comb (Const ("GtreeNode", _), t0), t1), t2), t3) ->
      trans_opt opt_th
      (INST [t3, var_t3; t2, var_t2; t1, var_t1; t0, var_t0] gtree_empty_case2)
    | Const ("GtreeLeaf0", _) -> trans_opt opt_th gtree_empty_case3
    | Const ("GtreeLeaf1", _) -> trans_opt opt_th gtree_empty_case4
    | Const ("GtreeLeaf2", _) -> trans_opt opt_th gtree_empty_case5
    | Const ("GtreeLeaf3", _) -> trans_opt opt_th gtree_empty_case6
    | Const ("GtreeLeaf01", _) -> trans_opt opt_th gtree_empty_case7
    | Const ("GtreeLeaf12", _) -> trans_opt opt_th gtree_empty_case8
    | Const ("GtreeLeaf13", _) -> trans_opt opt_th gtree_empty_case9
    | Const ("GtreeLeaf23", _) -> trans_opt opt_th gtree_empty_case10
    | _ -> failwith "No match: f_gtree_empty"
     in
  f_gtree_empty
;;

