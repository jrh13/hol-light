  let var_b2 = standardize_tm (mk_var ("b2", `:bool`)) in
  let var_b3 = standardize_tm (mk_var ("b3", `:bool`)) in
  let var_mc = standardize_tm (mk_var ("mc'", `:(bool)list`)) in
  let var_b4 = standardize_tm (mk_var ("b4", `:bool`)) in
  let var_b5 = standardize_tm (mk_var ("b5", `:bool`)) in
  let var_cpc = standardize_tm (mk_var ("cpc", `:(cpstep)list`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rlblblblblblblbl" (concl CFCTR_MAP_CASES_case5),
 List.map (C follow_full_path (concl CFCTR_MAP_CASES_case5))
   ["rlblblblblblblblbrrrrrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let abs_2_th =
