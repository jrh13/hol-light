let f_cfcbr1 =
  let cfcbr1_x_case1, cfcbr1_x_case2 =
    match List.map standardize (local_split_thm cfcbr1_x) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_e1 = standardize_tm (mk_var ("e", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_g = standardize_tm (mk_var ("g", `:color->color`)) in
  let var_e = standardize_tm (mk_var ("e", `:color`)) in
  let var_et = standardize_tm (mk_var ("et'", `:(color)list`)) in
  let var_c = standardize_tm (mk_var ("c", `:color`)) in
  let abs_1_th =
    let abs_tm =
      list_mk_comb
 (follow_full_path "rrrrrlrr" (concl cfcbr1_x_case2),
   List.map (C follow_full_path (concl cfcbr1_x_case2)) ["rrrrrlrrbrr"]) in
    standardize (GEN_BETAS_CONV abs_tm) in
  let COND_ctree_T = standardize (INST_TYPE [`:ctree`, aty] COND_T) in
  let COND_ctree_F = standardize (INST_TYPE [`:ctree`, aty] COND_F) in
  let rec abs_1 (g, func_g) c opt_th =
    let base_th = trans_opt opt_th (INST [c, var_c; g, var_g] abs_1_th) in
    match concl base_th with
    | Comb (_, Comb ((Comb (_, a2) as a1), _)) ->
      let r1 = func_g c None in
      let r2 = MK_COMB (REFL a1, r1) in
      f_permc a2 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and f_cfcbr1 tm1 tm2 opt_th =
    match (tm1, tm2) with
    | ((g, func_g), Const ("NIL", _)) ->
      trans_opt opt_th (INST [g, var_g] cfcbr1_x_case1)
    | ((g, func_g), Comb (Comb (Const ("CONS", _), e), et)) ->
      let base_th =
        trans_opt opt_th
          (INST [g, var_g; et, var_et; e, var_e] cfcbr1_x_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a6, Comb (_, a1)), a15),
 (Comb (Comb (Comb (_, Comb (_, a2)), (Comb (a3, _) as a13)),
 (Comb (Comb (Comb (_, Comb (Comb (a4, _), a5)), (Comb
 (_, Comb (Comb (_, a7), _)) as a11)),
 (Comb (a10, Comb (Comb (_, (Comb (_, a8) as a9)), _)) as a12)) as a14))
   as a16))) ->
        let r1 = func_g e None in
        let r2 =
          let r2 = MK_COMB (MK_COMB (REFL a4, r1), REFL a1) in
          f_EQ_color (rand (concl r1)) a1 (Some r2) in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a6, r2), REFL a15), REFL a16) in
          let th1 = INST [(a15, var_t); (a16, var_e1)] COND_ctree_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a6, r2), REFL a15), REFL a16) in
          let th1 = INST [(a15, var_t); (a16, var_e1)] COND_ctree_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 =
            let r3 = MK_COMB (MK_COMB (REFL a4, r1), REFL a2) in
            f_EQ_color (rand (concl r1)) a2 (Some r3) in
          if is_true_th r3 then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a6, r3), REFL a13), REFL a14) in
            let th1 = INST [(a13, var_t); (a14, var_e1)] COND_ctree_T in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r4 = f_cfcbr1 (g, func_g) et None in
            let r5 = MK_COMB (REFL a3, r4) in
            f_ctree_cons1 (rand (concl r4)) (Some (TRANS base_th r5))
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a6, r3), REFL a13), REFL a14) in
            let th1 = INST [(a13, var_t); (a14, var_e1)] COND_ctree_F in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r4 =
              let r4 = MK_COMB (MK_COMB (REFL a4, r1), REFL a5) in
              f_EQ_color (rand (concl r1)) a5 (Some r4) in
            if is_true_th r4 then
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a6, r4), REFL a11), REFL a12)
                  in
              let th1 = INST [(a11, var_t); (a12, var_e1)] COND_ctree_T in
              let base_th = TRANS (TRANS base_th th0) th1 in
              let r5 = (a7, f_ctree_cons_perm (g, func_g)) in
              let r6 = f_cfcbr2 r5 et None in
              let r7 = MK_COMB (REFL a10, r6) in
              f_ctree_cons2 (rand (concl r6)) (Some (TRANS base_th r7))
            else
              let th0 =
                MK_COMB (MK_COMB (MK_COMB (REFL a6, r4), REFL a11), REFL a12)
                  in
              let th1 = INST [(a11, var_t); (a12, var_e1)] COND_ctree_F in
              let base_th = TRANS (TRANS base_th th0) th1 in
              let r5 = (a8, abs_1 (g, func_g)) in
              let r6 = (a9, f_ctree_cons_perm r5) in
              let r7 = f_cfcbr2 r6 et None in
              let r8 = MK_COMB (REFL a10, r7) in
              f_ctree_cons2 (rand (concl r7)) (Some (TRANS base_th r8))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_cfcbr1"

   in
  f_cfcbr1
;;

let f_edge_rot =
  let edge_rot_DEF_case1, edge_rot_DEF_case2, edge_rot_DEF_case3,
    edge_rot_DEF_case4 =
