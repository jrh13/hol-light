    match tm1 with
    | Comb (Comb (Const (",", _), x), y) ->
      trans_opt opt_th (INST [x, var_x; y, var_y] FST_case1)
    | _ -> failwith "No match: f_FST_bool_list_bool_list"
     in
  f_FST_bool_list_bool_list
