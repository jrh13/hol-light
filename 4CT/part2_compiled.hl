  let var_bl = standardize_tm (mk_var ("bl", `:ctree`)) in
  let var_cl = standardize_tm (mk_var ("cl", `:ctree`)) in
  let rec f_ctree_union_rotlr tm1 tm2 opt_th =
    match (tm1, tm2) with
