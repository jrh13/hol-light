      | _ -> failwith "bad pattern"
      )
    | (Comb (Const ("CtreeLeaf", _), ll), Comb (Comb
                               (Comb (Const ("CtreeNode", _), ar), br), cr)) ->
      let base_th =
        trans_opt opt_th
 (INST [cr, var_cr; br, var_br; ar, var_ar; ll, var_ll]
   CTREE_UNION_ROTLR_FO_case4) in
      (match concl base_th with
      | Comb (_, Comb ((Comb (_, a3) as a2), Comb (Comb (Comb (a1, _), _), _)))
        ->
