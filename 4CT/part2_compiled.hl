    | Const ("Color0", _) -> trans_opt opt_th edge_rot_DEF_case1
    | Const ("Color1", _) -> trans_opt opt_th edge_rot_DEF_case2
    | Const ("Color2", _) -> trans_opt opt_th edge_rot_DEF_case3
    | Const ("Color3", _) -> trans_opt opt_th edge_rot_DEF_case4
