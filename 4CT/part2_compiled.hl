      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_TL_bool (rand (concl r1)) (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      abs_6 b1 b2 cp mc1 (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"

  and abs_8 cp mc1 mr1 b1 opt_th =
    let base_th =
      trans_opt opt_th
        (INST [mc1, var_mc1; b1, var_b1; mr1, var_mr1; cp, var_cp] abs_8_th) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (_, a1), _))) ->
      let r1 = f_EL_bool a1 mr1 None in
      let r2 = MK_COMB (REFL a2, r1) in
      abs_7 b1 cp mc1 mr1 (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_9 b1 b2 b3 opt_th =
    let base_th =
      trans_opt opt_th (INST [b3, var_b3; b2, var_b2; b1, var_b1] abs_9_th) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_nsp b1 b2 b3 None in
      let r2 = MK_COMB (REFL a1, r1) in
      f_NOT (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"

  and abs_10 b1 mr1 b2 opt_th =
