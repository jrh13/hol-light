            TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | (mr1, mc1, Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp)) ->
      let base_th =
        trans_opt opt_th
        (INST [mc1, var_mc1; mr1, var_mr1; cp, var_cp] CFCTR_OK_CASES_case5) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a5, Comb ((Comb (_, a2) as a1), _)),
 (Comb (Comb (_, Comb ((Comb (_, a4) as a3), _)), (Comb
                               (a7, Comb (Comb (_, a6), _)) as a8)) as a9))) ->
        let r1 = f_LENGTH_bool mr1 None in
