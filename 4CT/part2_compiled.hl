            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a4), REFL a5) in
            let th1 = INST [(a4, var_t1); (a5, var_e)] COND_gtree_pair_T in
            TRANS (TRANS base_th th0) th1
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a4), REFL a5) in
            let th1 = INST [(a4, var_t1); (a5, var_e)] COND_gtree_pair_F in
