    | Comb (Const ("CtreeLeaf", _), lf) ->
      trans_opt opt_th (INST [lf, var_lf] ctree_rotl_case2)
    | Const ("CtreeEmpty", _) -> trans_opt opt_th ctree_rotl_case3
    | _ -> failwith "No match: f_ctree_rotl"
     in
  f_ctree_rotl
