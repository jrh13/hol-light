let f_EQ_gtree_pair =
  let EQ_GTREE_PAIR_case1, EQ_GTREE_PAIR_case2 =
    match List.map standardize (local_split_thm EQ_GTREE_PAIR) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_a01 = standardize_tm (mk_var ("a0", `:gtree`)) in
  let var_a11 = standardize_tm (mk_var ("a1", `:gtree`)) in
  let var_a0 = standardize_tm (mk_var ("a0'", `:gtree`)) in
  let var_a1 = standardize_tm (mk_var ("a1'", `:gtree`)) in
  let var_x = standardize_tm (mk_var ("x", `:gtree_pair`)) in
  let rec f_EQ_gtree_pair tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (x, x1) when compare x x1 = 0 ->
      trans_opt opt_th (INST [x, var_x] EQ_GTREE_PAIR_case1)
    | (Comb (Comb (Const ("GtreePair", _), a01), a11), Comb
       (Comb (Const ("GtreePair", _), a0), a1)) ->
      let base_th =
        trans_opt opt_th
 (INST [a1, var_a1; a0, var_a0; a11, var_a11; a01, var_a01]
   EQ_GTREE_PAIR_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1', _), a2)) ->
        let r1 = f_EQ_gtree a01 a0 None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1', r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EQ_gtree a11 a1 (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1', r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EQ_gtree_pair"
     in
  f_EQ_gtree_pair
;;

let f_EQ_gtree_pair_list =
  let EQ_LIST_case1, EQ_LIST_case2, EQ_LIST_case3, EQ_LIST_case4 =
    match List.map standardize
 (inst_type_thms `:(gtree_pair)list->(gtree_pair)list->bool`
 (local_split_thm EQ_LIST)) with
    | [th1; th2; th3; th4] -> (th1, th2, th3, th4)
    | _ -> failwith "error"
     in
  let var_x = standardize_tm (mk_var ("x", `:gtree_pair`)) in
  let var_xs = standardize_tm (mk_var ("xs", `:(gtree_pair)list`)) in
  let var_y = standardize_tm (mk_var ("y", `:gtree_pair`)) in
  let var_ys = standardize_tm (mk_var ("ys", `:(gtree_pair)list`)) in
  let rec f_EQ_gtree_pair_list tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (xs, xs1) when compare xs xs1 = 0 ->
      trans_opt opt_th (INST [xs, var_xs] EQ_LIST_case1)
    | (Const ("NIL", _), Comb (Comb (Const ("CONS", _), x), xs)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case2)
    | (Comb (Comb (Const ("CONS", _), x), xs), Const ("NIL", _)) ->
      trans_opt opt_th (INST [xs, var_xs; x, var_x] EQ_LIST_case3)
    | (Comb (Comb (Const ("CONS", _), x), xs), Comb (Comb
                                                (Const ("CONS", _), y), ys)) ->
      let base_th =
        trans_opt opt_th
          (INST [ys, var_ys; y, var_y; xs, var_xs; x, var_x] EQ_LIST_case4) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a1, _), a2)) ->
        let r1 = f_EQ_gtree_pair x y None in
        if is_true_th r1 then
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_EQ_gtree_pair_list xs ys (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
          let th1 = INST[a2, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_EQ_gtree_pair_list"
     in
  f_EQ_gtree_pair_list
;;

let f_HD_gtree_pair =
  let HD_case1 =
    match List.map standardize
     (inst_type_thms `:(gtree_pair)list->gtree_pair` (local_split_thm HD)) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_h = standardize_tm (mk_var ("h", `:gtree_pair`)) in
  let var_t = standardize_tm (mk_var ("t", `:(gtree_pair)list`)) in
  let rec f_HD_gtree_pair tm1 opt_th =
    match tm1 with
    | Comb (Comb (Const ("CONS", _), h), t) ->
      trans_opt opt_th (INST [h, var_h; t, var_t] HD_case1)
    | _ -> failwith "No match: f_HD_gtree_pair"
     in
