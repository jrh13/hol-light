    let base_th =
      trans_opt opt_th
        (INST [p, var_p; gtu, var_gtu; ktc0, var_ktc0] ktc_apply_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (_, Comb (_, a1)), Comb
                           (a3, Comb (_, a2))), _)) ->
      let r1 = f_ctree_pair_sub p a1 None in
      let r2 = f_ctree_pair_sub p a2 None in
      let r3 =
        let r3 = MK_COMB (REFL a3, r2) in
        f_ctree_rotlr (rand (concl r2)) (Some r3) in
      let r4 = MK_COMB (MK_COMB (MK_COMB (REFL ktc0, r1), r3), REFL gtu) in
      func_ktc0 (rand (concl r1)) (rand (concl r3)) gtu
        (Some (TRANS base_th r4))
    | _ -> failwith "bad pattern"
     in
  f_ktc_apply
;;

let f_ktc_step =
  let ktc_step_fo_u_x_case1 =
    match List.map standardize (local_split_thm ktc_step_fo_u_x) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:ctree#gtree_pair`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree#gtree_pair`)) in
  let var_h = standardize_tm (mk_var ("h", `:num`)) in
  let var_ktc0 =
    standardize_tm
      (mk_var ("ktc0", `:ctree->ctree->gtree->ctree#gtree_pair`)) in
  let var_ctu = standardize_tm (mk_var ("ctu", `:ctree`)) in
  let var_gtr = standardize_tm (mk_var ("gtr", `:gtree`)) in
  let var_gtu = standardize_tm (mk_var ("gtu", `:gtree`)) in
  let COND_ctree_gtree_pair_T =
    standardize (INST_TYPE [`:ctree#gtree_pair`, aty] COND_T) in
  let COND_ctree_gtree_pair_F =
    standardize (INST_TYPE [`:ctree#gtree_pair`, aty] COND_F) in
  let rec f_ktc_step h (ktc0, func_ktc0) ctu gtr gtu opt_th =
    let base_th =
      trans_opt opt_th
 (INST [gtu, var_gtu; gtr, var_gtr; ctu, var_ctu; ktc0, var_ktc0; h, var_h]
   ktc_step_fo_u_x_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (_, a9), (Comb (_, (Comb (Comb (Comb (a1, _), a6),
 (Comb (Comb (a5, Comb (Comb (Comb (a3, Comb (_, a2)), _), a4)), _) as a7)) as
   a8)) as a10))) ->
      let r1 = f_ctree_empty ctu None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a9), REFL a10) in
        let th1 = INST [(a9, var_t); (a10, var_e)] COND_ctree_gtree_pair_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a9), REFL a10) in
        let th1 = INST [(a9, var_t); (a10, var_e)] COND_ctree_gtree_pair_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = f_gtree_empty gtr None in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r2), REFL a9), REFL a8) in
          let th1 = INST [(a9, var_t); (a8, var_e)] COND_ctree_gtree_pair_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r2), REFL a9), REFL a8) in
          let th1 = INST [(a9, var_t); (a8, var_e)] COND_ctree_gtree_pair_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = f_gtree_empty gtu None in
          if is_true_th r3 then
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a1, r3), REFL a6), REFL a7) in
            let th1 =
              INST [(a6, var_t); (a7, var_e)] COND_ctree_gtree_pair_T in
            TRANS (TRANS base_th th0) th1
          else
            let th0 =
              MK_COMB (MK_COMB (MK_COMB (REFL a1, r3), REFL a6), REFL a7) in
            let th1 =
              INST [(a6, var_t); (a7, var_e)] COND_ctree_gtree_pair_F in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r4 = f_REPLICATE_bool h a2 None in
            let r5 =
              let r5 =
                MK_COMB (MK_COMB (MK_COMB (REFL a3, r4), REFL ctu), REFL a4) in
              f_ctree_restrict_u (rand (concl r4)) ctu a4 (Some r5) in
            let r6 = MK_COMB (MK_COMB (REFL a5, r5), REFL gtu) in
            f_ktc_apply (ktc0, func_ktc0) (rand (concl r5)) gtu
              (Some (TRANS base_th r6))
    | _ -> failwith "bad pattern"
     in
  f_ktc_step
;;

