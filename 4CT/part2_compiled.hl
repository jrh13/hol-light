          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_HD_color et None in
          let r3 =
            let r3 = MK_COMB (REFL a3, r2) in
            f_permc a4 (rand (concl r2)) (Some r3) in
          let r4 =
            let r4 = MK_COMB (REFL a5, r2) in
            f_permc a6 (rand (concl r2)) (Some r4) in
          let r5 = f_TL_color et None in
          let r6 = MK_COMB (MK_COMB (REFL a7, r4), r5) in
          let r7 = MK_COMB (MK_COMB (REFL a7, r3), r6) in
          let r8 =
            let r8 = MK_COMB (REFL a8, r7) in
            f_cpcol cp (rand (concl r7)) (Some r8) in
          let r9 = MK_COMB (MK_COMB (REFL a7, r3), r5) in
          let r10 = MK_COMB (MK_COMB (REFL a7, r4), r9) in
          let r11 =
            let r11 = MK_COMB (REFL a8, r10) in
            f_cpcol cp (rand (concl r10)) (Some r11) in
          let r12 = MK_COMB (MK_COMB (REFL a9, r8), r11) in
          f_ctree_union (rand (concl r8)) (rand (concl r11))
            (Some (TRANS base_th r12))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Const ("CONS", _), Const ("CpH", _)), cp), et) ->
      let base_th =
        trans_opt opt_th (INST [et, var_et; cp, var_cp] CPCOL_CLAUSES_case5) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (_, Comb (Comb (a1, _), a2)), a16),
 (Comb (Comb (Comb (a5, Comb (Comb (a4, _), Comb (_, Comb (a11, _)))),
 (Comb (Comb (a10, Comb (_, Comb (Comb (a12, Comb ((Comb (_, a7) as a6), _)),
 _))),
 Comb (a13, Comb (Comb (_, Comb ((Comb (_, a9) as a8), Comb (a3, _))), _))) as
   a14)), a15) as a17))) ->
        let r1 = f_LENGTH_color et None in
