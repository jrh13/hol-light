  let var_bs = standardize_tm (mk_var ("bs", `:bit_stack`)) in
  let var_g = standardize_tm (mk_var ("g", `:gtree`)) in
  let var_r = standardize_tm (mk_var ("r", `:ctree_restriction`)) in
  let var_lf = standardize_tm (mk_var ("lf", `:ctree`)) in
  let var_b = standardize_tm (mk_var ("b", `:bool`)) in
  let var_t1 = standardize_tm (mk_var ("t1", `:ctree`)) in
  let var_t2 = standardize_tm (mk_var ("t2", `:ctree`)) in
  let var_t3 = standardize_tm (mk_var ("t3", `:ctree`)) in
  let var_t = standardize_tm (mk_var ("t", `:ctree`)) in
  let var_r1 = standardize_tm (mk_var ("r1", `:ctree_restriction`)) in
  let var_r2 = standardize_tm (mk_var ("r2", `:ctree_restriction`)) in
  let var_r3 = standardize_tm (mk_var ("r3", `:ctree_restriction`)) in
  let rec f_ctree_restrict_split_u tm1 tm2 tm3 tm4 tm5 opt_th =
    match (tm1, tm2, tm3, tm4, tm5) with
    | (hs, t1, t2, t3, Comb (Comb (Const (",", _), r1), Comb
                             (Comb (Const (",", _), r2), r3))) ->
      let base_th =
        trans_opt opt_th
 (INST [hs, var_hs; r3, var_r3; r2, var_r2; r1, var_r1; t3, var_t3; t2, var_t2;
        t1, var_t1] CTREE_RESTRICT_SPLIT_U_P_case1) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), _), _)) ->
        let r1' = f_ctree_restrict_u hs t1 r1 None in
        let r2' = f_ctree_restrict_u hs t2 r2 None in
        let r3' = f_ctree_restrict_u hs t3 r3 None in
        let r4 = MK_COMB (MK_COMB (MK_COMB (REFL a1, r1'), r2'), r3') in
        f_ctree_cons_pairs (rand (concl r1')) (rand (concl r2'))
          (rand (concl r3')) (Some (TRANS base_th r4))
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_ctree_restrict_split_u"

  and f_ctree_restrict_u tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (hs, t, Const ("CtrNil", _)) ->
      trans_opt opt_th (INST [t, var_t; hs, var_hs] CTREE_RESTRICT_U_case1)
    | (Const ("NIL", _), Comb (Comb (Comb (Const ("CtreeNode", _), t1), t2),
                   t3), Comb (Comb (Comb (Const ("CtrCons", _), bs), g), r)) ->
      let base_th =
        trans_opt opt_th
 (INST [t3, var_t3; t2, var_t2; t1, var_t1; r, var_r; g, var_g; bs, var_bs]
   CTREE_RESTRICT_U_case2) in
      (match concl base_th with
      | Comb (_, Comb (a2, Comb (_, a1))) ->
        let r1' = f_ctr_decr3 t1 t2 t3 a1 None in
        let r2' = MK_COMB (REFL a2, r1') in
        f_ctree_leaf_pair_q t1 t2 t3 (rand (concl r1'))
          (Some (TRANS base_th r2'))
      | _ -> failwith "bad pattern"
      )
    | (Comb (Comb (Const ("CONS", _), b), hs), Comb (Comb
 (Comb (Const ("CtreeNode", _), t1), t2), t3),
   Comb (Comb (Comb (Const ("CtrCons", _), bs), g), r)) ->
      let base_th =
        trans_opt opt_th
 (INST [r, var_r; g, var_g; bs, var_bs; t3, var_t3; t2, var_t2; t1, var_t1;
        hs, var_hs; b, var_b] CTREE_RESTRICT_U_case3) in
      (match concl base_th with
      | Comb (_, Comb (a3, Comb (Comb (_, a1), a2))) ->
        let r1' = f_ctr_split3 a1 a2 None in
        let r2' = MK_COMB (REFL a3, r1') in
        f_ctree_restrict_split_u hs t1 t2 t3 (rand (concl r1'))
          (Some (TRANS base_th r2'))
      | _ -> failwith "bad pattern"
      )
    | (hs, Comb (Const ("CtreeLeaf", _), lf), Comb (Comb
                                   (Comb (Const ("CtrCons", _), bs), g), r)) ->
      trans_opt opt_th
 (INST [r, var_r; g, var_g; bs, var_bs; lf, var_lf; hs, var_hs]
   CTREE_RESTRICT_U_case4)
    | (hs, Const ("CtreeEmpty", _), Comb (Comb (Comb
                                         (Const ("CtrCons", _), bs), g), r)) ->
      trans_opt opt_th
     (INST [r, var_r; g, var_g; bs, var_bs; hs, var_hs] CTREE_RESTRICT_U_case5)
    | _ -> failwith "No match: f_ctree_restrict_u"

   in
  (f_ctree_restrict_split_u, f_ctree_restrict_u)
