 (INST [c3, var_c3; b3, var_b3; a3, var_a3; c2, var_c2; b2, var_b2; a2, var_a2]
   CTREE_EMPTY_NODE_FO_case19)
    | Comb (Comb (Comb (Const ("CtreeNode", _), Const ("CtreeEmpty", _)), Comb
 (Comb (Comb (Const ("CtreeNode", _), a2), b2), c2)),
