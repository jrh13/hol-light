let f_ctree_disjoint =
  let ctree_disjoint_case1, ctree_disjoint_case2, ctree_disjoint_case3 =
    match List.map standardize (local_split_thm ctree_disjoint) with
    | [th1; th2; th3] -> (th1, th2, th3)
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:bool`)) in
  let var_t = standardize_tm (mk_var ("t", `:bool`)) in
  let var_tl = standardize_tm (mk_var ("tl", `:ctree`)) in
  let var_tr1 = standardize_tm (mk_var ("tr1", `:ctree`)) in
  let var_tr2 = standardize_tm (mk_var ("tr2", `:ctree`)) in
  let var_tr3 = standardize_tm (mk_var ("tr3", `:ctree`)) in
  let var_lr = standardize_tm (mk_var ("lr", `:ctree`)) in
  let COND_bool_T = standardize (INST_TYPE [`:bool`, aty] COND_T) in
  let COND_bool_F = standardize (INST_TYPE [`:bool`, aty] COND_F) in
  let rec f_ctree_disjoint tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (tl, Const ("CtreeEmpty", _)) ->
      trans_opt opt_th (INST [tl, var_tl] ctree_disjoint_case1)
    | (tl, Comb (Const ("CtreeLeaf", _), lr)) ->
      let base_th =
        trans_opt opt_th
          (INST [tl, var_tl; lr, var_lr] ctree_disjoint_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a1, _), a2), a3)) ->
        let r1 = f_ctree_leaf tl None in
        if is_true_th r1 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a2), REFL a3) in
          let th1 = INST [(a2, var_t); (a3, var_e)] COND_bool_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a1, r1), REFL a2), REFL a3) in
          let th1 = INST [(a2, var_t); (a3, var_e)] COND_bool_F in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | (tl, Comb (Comb (Comb (Const ("CtreeNode", _), tr1), tr2), tr3)) ->
      let base_th =
        trans_opt opt_th
 (INST [tl, var_tl; tr3, var_tr3; tr2, var_tr2; tr1, var_tr1]
   ctree_disjoint_case3) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a3, Comb (Comb (a1, _), a2)), a8),
    (Comb (Comb (a4, Comb (Comb (a5, _), _)), (Comb (_, a6) as a7)) as a9))) ->
        let r1 = f_ctree_empty tl None in
        let r2 =
          if is_true_th r1 then
            let th0 = MK_COMB (MK_COMB (REFL a1, r1), REFL a2) in
            let th1 = INST[a2, p_var_bool] T_OR in
            TRANS th0 th1
          else
            let a2_eq = f_ctree_leaf tl None in
            let or_th = INST[rand (concl a2_eq), p_var_bool] F_OR in
            TRANS (MK_COMB (MK_COMB (REFL a1, r1), a2_eq)) or_th in
        if is_true_th r2 then
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a8), REFL a9) in
          let th1 = INST [(a8, var_t); (a9, var_e)] COND_bool_T in
          TRANS (TRANS base_th th0) th1
        else
          let th0 =
            MK_COMB (MK_COMB (MK_COMB (REFL a3, r2), REFL a8), REFL a9) in
          let th1 = INST [(a8, var_t); (a9, var_e)] COND_bool_F in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r3 = f_ctree_lsub tl None in
          let r4 =
            let r4 = MK_COMB (MK_COMB (REFL a5, r3), REFL tr1) in
            f_ctree_disjoint (rand (concl r3)) tr1 (Some r4) in
          if is_true_th r4 then
            let th0 = MK_COMB (MK_COMB (REFL a4, r4), REFL a7) in
            let th1 = INST[a7, p_var_bool] T_AND in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r5 = f_ctree_msub tl None in
            let r6 =
              let r6 = MK_COMB (MK_COMB (REFL a5, r5), REFL tr2) in
              f_ctree_disjoint (rand (concl r5)) tr2 (Some r6) in
            if is_true_th r6 then
              let th0 = MK_COMB (MK_COMB (REFL a4, r6), REFL a6) in
              let th1 = INST[a6, p_var_bool] T_AND in
              let base_th = TRANS (TRANS base_th th0) th1 in
              let r7 = f_ctree_rsub tl None in
              let r8 = MK_COMB (MK_COMB (REFL a5, r7), REFL tr3) in
              f_ctree_disjoint (rand (concl r7)) tr3 (Some (TRANS base_th r8))
            else
              let th0 = MK_COMB (MK_COMB (REFL a4, r6), REFL a6) in
              let th1 = INST[a6, p_var_bool] F_AND in
              TRANS (TRANS base_th th0) th1
          else
            let th0 = MK_COMB (MK_COMB (REFL a4, r4), REFL a7) in
            let th1 = INST[a7, p_var_bool] F_AND in
            TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_ctree_disjoint"
     in
  f_ctree_disjoint
;;

let f_check_red_opt =
  let check_red_opt_case1, check_red_opt_case2 =
    match List.map standardize (local_split_thm check_red_opt) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_kp = standardize_tm (mk_var ("kp", `:ctree`)) in
  let var_cct = standardize_tm (mk_var ("cct", `:ctree`)) in
  let rec f_check_red_opt tm1 tm2 opt_th =
    match (tm1, tm2) with
    | (kp, Const ("NONE", _)) ->
      trans_opt opt_th (INST [kp, var_kp] check_red_opt_case1)
    | (kp, Comb (Const ("SOME", _), cct)) ->
      let base_th =
        trans_opt opt_th
          (INST [cct, var_cct; kp, var_kp] check_red_opt_case2) in
      f_ctree_disjoint kp cct (Some base_th)
    | _ -> failwith "No match: f_check_red_opt"
     in
  f_check_red_opt
;;

let f_REPLICATE_bool =
  let REPLICATE_NUM_case1 =
    match List.map standardize
 (inst_type_thms `:num->bool->(bool)list` (local_split_thm REPLICATE_NUM)) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_e = standardize_tm (mk_var ("e", `:(bool)list`)) in
  let var_t = standardize_tm (mk_var ("t", `:(bool)list`)) in
  let var_n = standardize_tm (mk_var ("n", `:num`)) in
  let var_x = standardize_tm (mk_var ("x", `:bool`)) in
  let COND_bool_list_T =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_T) in
  let COND_bool_list_F =
    standardize (INST_TYPE [`:(bool)list`, aty] COND_F) in
  let rec f_REPLICATE_bool n x opt_th =
    let base_th =
      trans_opt opt_th (INST [x, var_x; n, var_n] REPLICATE_NUM_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (Comb (a2, Comb (_, a1)), a6),
                     (Comb (a5, Comb (Comb (a4, Comb (_, a3)), _)) as a7))) ->
      let r1 = conv_EQ_num n a1 None in
      if is_true_th r1 then
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_T in
        TRANS (TRANS base_th th0) th1
      else
        let th0 =
          MK_COMB (MK_COMB (MK_COMB (REFL a2, r1), REFL a6), REFL a7) in
        let th1 = INST [(a6, var_t); (a7, var_e)] COND_bool_list_F in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = conv_SUB n a3 None in
        let r3 =
          let r3 = MK_COMB (MK_COMB (REFL a4, r2), REFL x) in
          f_REPLICATE_bool (rand (concl r2)) x (Some r3) in
        TRANS base_th (MK_COMB (REFL a5, r3))
    | _ -> failwith "bad pattern"
     in
  f_REPLICATE_bool
;;

